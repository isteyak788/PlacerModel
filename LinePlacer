    private bool RaycastToTerrain(Vector3 origin, out RaycastHit hit, LayerMask layer)
    {
        return Physics.Raycast(origin, Vector3.down, out hit, Mathf.Infinity, layer);
    }

    private bool IsValidPlacement(Vector3 position, Vector3 boundsExtents, bool canOverlap, bool occupyGrid)
    {
        if (!canOverlap)
        {
            Collider[] hitColliders = Physics.OverlapBox(position, boundsExtents, Quaternion.identity, overlapCheckLayerMask);
            // Filter out self or ghost objects if necessary, but for a general check, this is usually sufficient.
            if (hitColliders.Length > 0)
            {
                return false; // Overlapping an existing object
            }
        }

        if (occupyGrid)
        {
            Vector2Int minCell = WorldToGrid(position - boundsExtents);
            Vector2Int maxCell = WorldToGrid(position + boundsExtents);

            for (int x = minCell.x; x <= maxCell.x; x++)
            {
                for (int z = minCell.y; z <= maxCell.y; z++)
                {
                    if (_occupiedGridCells.Contains(new Vector2Int(x, z)))
                    {
                        return false; // Grid cell already occupied
                    }
                }
            }
        }
        return true;
    }

    // Basic Point In Polygon test (ray casting method)
    // Assumes a 2D polygon on the XZ plane
    private bool IsPointInPolygon(List<Vector3> polygon, Vector3 point)
    {
        int j = polygon.Count - 1;
        bool inside = false;
        for (int i = 0; i < polygon.Count; i++)
        {
            if (((polygon[i].z <= point.z && point.z < polygon[j].z) || (polygon[j].z <= point.z && point.z < polygon[i].z)) &&
                (point.x < (polygon[j].x - polygon[i].x) * (point.z - polygon[i].z) / (polygon[j].z - polygon[i].z) + polygon[i].x))
            {
                inside = !inside;
            }
            j = i;
        }
        return inside;
    }

    private void MarkOccupiedCells(Vector3 position, Vector3 boundsExtents)
    {
        Vector2Int minCell = WorldToGrid(position - boundsExtents);
        Vector2Int maxCell = WorldToGrid(position + boundsExtents);

        for (int x = minCell.x; x <= maxCell.x; x++)
        {
            for (int z = minCell.y; z <= maxCell.y; z++)
            {
                _occupiedGridCells.Add(new Vector2Int(x, z));
            }
        }
    }

    private void UnmarkOccupiedCells(Vector3 position, Vector3 boundsExtents)
    {
        Vector2Int minCell = WorldToGrid(position - boundsExtents);
        Vector2Int maxCell = WorldToGrid(position + boundsExtents);

        for (int x = minCell.x; x <= maxCell.x; x++)
        {
            for (int z = minCell.y; z <= maxCell.y; z++)
            {
                _occupiedGridCells.Remove(new Vector2Int(x, z));
            }
        }
    }

    private Vector2Int WorldToGrid(Vector3 worldPos)
    {
        return new Vector2Int(Mathf.FloorToInt(worldPos.x / gridSize), Mathf.FloorToInt(worldPos.z / gridSize));
    }

