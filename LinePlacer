    // Updates live previews for objects along the circumference of a circle
    private void UpdateCircleObjectPreviews()
    {
        ClearObjectPreviews();
        if (_currentSelectedEntry == null || !_currentSelectedEntry.showGhost || !_isDrawingCircle || !_mouseWorldPositionFound || _circleRadius <= 0) return;

        if ((_currentActiveMode == ActivePlacementMode.LineCircle || _currentActiveMode == ActivePlacementMode.LineCircleFill) && _currentActiveLineGhostPrefab != null)
        {
            Vector3 lineBoundsExtents = _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents;
            float objectLength = lineBoundsExtents.z * 2;
            float objectWidth = lineBoundsExtents.x * 2;
            float effectiveObjectSize = objectLength + objectSpacing;

            // Calculate circumference
            float circumference = 2 * Mathf.PI * _circleRadius;
            int numberOfObjects = Mathf.FloorToInt(circumference / effectiveObjectSize);

            if (numberOfObjects > 0)
            {
                float angleStep = 360f / numberOfObjects;
                for (int i = 0; i < numberOfObjects; i++)
                {
                    float angle = i * angleStep;
                    Vector3 pointOnCircle = _circleCenter + new Vector3(Mathf.Cos(Mathf.Deg2Rad * angle), 0, Mathf.Sin(Mathf.Deg2Rad * angle)) * _circleRadius;

                    RaycastHit hit;
                    if (RaycastToTerrain(pointOnCircle + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        pointOnCircle.y = hit.point.y;
                    }
                    else
                    {
                        // If raycast fails, use the original interpolated y or some default
                        // For now, let's just use the interpolated y if terrain not found.
                        continue;
                    }

                    Vector3 direction = (pointOnCircle - _circleCenter).normalized; // Direction from center to object
                    Quaternion objectRotation = Quaternion.LookRotation(direction);

                    if (objectsRotatedRightOfLine)
                    {
                        objectRotation *= Quaternion.Euler(0, 90, 0); // Rotate 90 degrees relative to the radial direction
                        Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                        pointOnCircle += perpendicularOffset;
                    }

                    bool isValid = IsValidPlacement(pointOnCircle, lineBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
                    GameObject preview = Instantiate(_currentActiveLineGhostPrefab, pointOnCircle, objectRotation);
                    currentObjectPreviews.Add(preview);
                    SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
                }
            }
        }

        // NEW: If LineCircleFill, also show a preview of the fill.
        if (_currentActiveMode == ActivePlacementMode.LineCircleFill && _currentActiveFillGhostPrefab != null)
        {
            Vector3 fillBoundsExtents = _currentSelectedEntry.fillBuildingInfo.buildingBoundsExtents;
            GenerateCircleFillPreviews(_circleCenter, _circleRadius, _currentActiveFillGhostPrefab, fillBoundsExtents, fillObjectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
        }
    }

    // NEW: Method to update live previews for objects along a line, including loops
    private void UpdateLineObjectPreviews(bool isClosedLoop)
    {
        ClearObjectPreviews();
        if (_currentSelectedEntry == null || !_currentSelectedEntry.showGhost || _currentActiveLineGhostPrefab == null || linePoints.Count < 1 || !_mouseWorldPositionFound) return;

        Vector3 lineBoundsExtents = _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents;
        float objectLength = lineBoundsExtents.z * 2;
        float objectWidth = lineBoundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        List<Vector3> currentPath = new List<Vector3>(linePoints);
        if (linePoints.Count > 0)
        {
            // Add the current mouse position as the potential next point
            currentPath.Add(_mouseWorldPosition);
        }

        if (currentPath.Count < 2) return; // Only generate previews if there are enough points

        // Check for minimum points required for specific modes to show previews
        if (_currentActiveMode == ActivePlacementMode.Line && currentPath.Count < 2) return;
        if ((_currentActiveMode == ActivePlacementMode.LineLoop || _currentActiveMode == ActivePlacementMode.LineLoopFill) && currentPath.Count < 3) return;

        List<Vector3> interpolatedPoints = new List<Vector3>();

        // Generate interpolated points for smooth curves
        for (int i = 0; i < currentPath.Count - 1; i++)
        {
            Vector3 p0 = i == 0 ? currentPath[0] : currentPath[i - 1]; // Use first point twice if at start
            Vector3 p1 = currentPath[i];
            Vector3 p2 = currentPath[i + 1];
            Vector3 p3 = (i + 2 >= currentPath.Count) ? currentPath[currentPath.Count - 1] : currentPath[i + 2]; // Use last point twice if at end

            for (int j = 0; j <= curveResolution; j++)
            {
                float t = (float)j / curveResolution;
                // Catmull-Rom spline interpolation
                Vector3 interpolatedPoint = GetCatmullRomPosition(t, p0, p1, p2, p3);

                RaycastHit hit;
                if (RaycastToTerrain(interpolatedPoint + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    interpolatedPoint.y = hit.point.y;
                }
                else
                {
                    // If raycast fails, use the original interpolated y or some default
                    // For now, let's just use the interpolated y if terrain not found.
                }
                interpolatedPoints.Add(interpolatedPoint);
            }
        }

        // Add interpolated points for the closing segment if it's a closed loop
        if (isClosedLoop && currentPath.Count >= 3)
        {
            Vector3 p0_loop = currentPath[currentPath.Count - 2];
            Vector3 p1_loop = currentPath[currentPath.Count - 1];
            Vector3 p2_loop = currentPath[0];
            Vector3 p3_loop = currentPath[1];

            for (int j = 0; j <= curveResolution; j++)
            {
                float t = (float)j / curveResolution;
                Vector3 interpolatedPoint = GetCatmullRomPosition(t, p0_loop, p1_loop, p2_loop, p3_loop);
                RaycastHit hit;
                if (RaycastToTerrain(interpolatedPoint + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    interpolatedPoint.y = hit.point.y;
                }
                interpolatedPoints.Add(interpolatedPoint);
            }
        }

        // Generate objects along the interpolated path using the new generic preview function
        GenerateObjectsAlongPathPreviews(interpolatedPoints, _currentActiveLineGhostPrefab, lineBoundsExtents, objectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid, objectsRotatedRightOfLine, curveResolution);

        // NEW: If it's a fill mode, also show a preview of the fill
        if (_currentActiveMode == ActivePlacementMode.LineLoopFill && _currentActiveFillGhostPrefab != null && linePoints.Count >= 2)
        {
            Vector3 fillBoundsExtents = _currentSelectedEntry.fillBuildingInfo.buildingBoundsExtents;
            GenerateLineLoopFillPreviews(linePoints, _mouseWorldPosition, _currentActiveFillGhostPrefab, fillBoundsExtents, fillObjectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
        }
    }

    // Generic method to clear all active ghost/preview objects
    private void ClearObjectPreviews()
    {
        foreach (GameObject preview in currentObjectPreviews)
        {
            if (preview != null)
            {
                Destroy(preview);
            }
