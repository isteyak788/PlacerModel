        [Tooltip("Button to activate Line Loop Placement with lineBuildingInfo.")]
        public Button lineLoopButton;
        [Tooltip("Button to activate Box Line placement (uses lineBuildingInfo).")]
        public Button boxLineButton;
        [Tooltip("Button to activate Box Fill placement (uses fillBuildingInfo).")]
        public Button boxFillButton;
        [Tooltip("Button to activate Line Loop Fill placement (uses both lineBuildingInfo and fillBuildingInfo).")]
        public Button lineLoopFillButton;
        [Tooltip("Button to activate Line Circle placement (uses lineBuildingInfo).")]
        public Button lineCircleButton;
        [Tooltip("Button to activate Line Circle Fill placement (uses both lineBuildingInfo and fillBuildingInfo).")]
