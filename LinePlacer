                if (IsValidPlacement(objectPosition, lineBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid))
                {
                    GameObject placedObject = Instantiate(_currentActiveLinePlacementPrefab, objectPosition, objectRotation, _currentPlacementParent.transform);
                    placedObjects.Add(placedObject);
                    OccupyGridCells(objectPosition, lineBoundsExtents);
                }
            }
        }

        if (_currentSelectedEntry.combineLineMeshes && placedObjects.Count > 1)
        {
            CombineMeshes(placedObjects, _currentPlacementParent.transform, _currentActiveLinePlacementPrefab.GetComponent<MeshRenderer>()?.sharedMaterial);
        }

        if (finalize) FinalizePlacement(); // Conditional finalize
    }

