        {
            Debug.LogError("Invalid object size or spacing for circle fill. Cannot place objects.");
            ExitPlacementMode();
            return;
        }

        // Iterate in a square grid within the circle's bounding box
        for (float x = _circleCenter.x - _circleRadius; x <= _circleCenter.x + _circleRadius; x += step)
        {
            for (float z = _circleCenter.z - _circleRadius; z <= _circleCenter.z + _circleRadius; z += step)
            {
                Vector3 position = new Vector3(x, _circleCenter.y, z);

                // Check if the current position is within the circle
                if (Vector3.Distance(_circleCenter, new Vector3(position.x, _circleCenter.y, position.z)) <= _circleRadius)
                {
                    RaycastHit hit;
                    if (RaycastToTerrain(position + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
