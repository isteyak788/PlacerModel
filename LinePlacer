        }

        if (_currentSelectedEntry.combineFillMeshes && fillObjects.Count > 0)
        {
            CombineMeshes(fillObjects, _currentActiveFillPlacementPrefab.GetComponent<MeshRenderer>()?.sharedMaterial, "CombinedCircleFillMesh");
