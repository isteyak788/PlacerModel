    private void PlaceObjectsInCircle()
    {
        if (_currentSelectedEntry == null || _currentActiveLinePlacementPrefab == null || _circleRadius <= 0)
        {
            Debug.LogWarning("Cannot place circle objects: missing line prefab or invalid radius.");
            ExitPlacementMode();
            return;
        }

        Vector3 lineBoundsExtents = _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents;
        float objectLength = lineBoundsExtents.z * 2;
        float objectWidth = lineBoundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        float circumference = 2 * Mathf.PI * _circleRadius;
        int numberOfObjects = Mathf.FloorToInt(circumference / effectiveObjectSize);

        List<GameObject> placedLineObjects = new List<GameObject>();

        if (numberOfObjects > 0)
        {
            float angleStep = 360f / numberOfObjects;
            for (int i = 0; i < numberOfObjects; i++)
            {
                float angle = i * angleStep;
                Vector3 pointOnCircle = _circleCenter + new Vector3(Mathf.Cos(Mathf.Deg2Rad * angle), 0, Mathf.Sin(Mathf.Deg2Rad * angle)) * _circleRadius;

                RaycastHit hit;
                if (RaycastToTerrain(pointOnCircle + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    pointOnCircle.y = hit.point.y;
                }
                else
                {
                    continue;
                }

                Vector3 direction = (pointOnCircle - _circleCenter).normalized;
                Quaternion objectRotation = Quaternion.LookRotation(direction);
                if (objectsRotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0);
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    pointOnCircle += perpendicularOffset;
                }

                if (_currentPlacementParent == null) _currentPlacementParent = InstantiatePlacementParent(pointOnCircle);
                if (IsValidPlacement(pointOnCircle, lineBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid))
                {
                    GameObject placedObject = Instantiate(_currentActiveLinePlacementPrefab, pointOnCircle, objectRotation, _currentPlacementParent.transform);
                    placedLineObjects.Add(placedObject);
                    if (_currentSelectedEntry.occupyGrid) _occupiedGridCells.Add(WorldToGrid(pointOnCircle));
                }
            }
        }

        if (_currentSelectedEntry.combineLineMeshes && placedLineObjects.Count > 1)
        {
            CombineMeshes(placedLineObjects, "CombinedCircleLineMesh");
        }

        Debug.Log($"Placed {placedLineObjects.Count} circle perimeter objects.");

        // Reset circle drawing state immediately after placement
        _isDrawingCircle = false;
        _circleRadius = 0;
        // Assuming the main LineRenderer might also be used for circle preview, disable it
        GetComponent<LineRenderer>().enabled = false;
        currentState = LinePlacementState.Idle; // Return to idle state after placement


        if (!_currentSelectedEntry.isContinuous) ExitPlacementMode();
    }

    private void PlaceAllObjectsFromLineCircleFill()
    {
        bool hasLinePrefab = _currentActiveLinePlacementPrefab != null;
        bool hasFillPrefab = _currentActiveFillPlacementPrefab != null;

        if (_currentSelectedEntry == null || (!hasLinePrefab && !hasFillPrefab) || _circleRadius <= 0)
        {
            Debug.LogWarning("Cannot place circle fill objects: missing both line and fill prefabs or invalid radius.");
            ExitPlacementMode();
            return;
        }

        // Place line objects (perimeter) if line prefab is available
        if (hasLinePrefab)
        {
            Vector3 lineBoundsExtents = _currentSelectedEntry.lineBuildingInfo != null ? _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents : Vector3.one * 0.5f;
            float objectLength = lineBoundsExtents.z * 2;
            float objectWidth = lineBoundsExtents.x * 2;
            float effectiveObjectSize = objectLength + objectSpacing;

            float circumference = 2 * Mathf.PI * _circleRadius;
            int numberOfObjects = Mathf.FloorToInt(circumference / effectiveObjectSize);

            List<GameObject> placedLineObjects = new List<GameObject>();

            if (numberOfObjects > 0)
            {
                float angleStep = 360f / numberOfObjects;
                for (int i = 0; i < numberOfObjects; i++)
                {
                    float angle = i * angleStep;
                    Vector3 pointOnCircle = _circleCenter + new Vector3(Mathf.Cos(Mathf.Deg2Rad * angle), 0, Mathf.Sin(Mathf.Deg2Rad * angle)) * _circleRadius;

                    RaycastHit hit;
                    if (RaycastToTerrain(pointOnCircle + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        pointOnCircle.y = hit.point.y;
                    }
                    else
                    {
                        continue;
                    }

                    Vector3 direction = (pointOnCircle - _circleCenter).normalized;
                    Quaternion objectRotation = Quaternion.LookRotation(direction);
                    if (objectsRotatedRightOfLine)
                    {
                        objectRotation *= Quaternion.Euler(0, 90, 0);
                        Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                        pointOnCircle += perpendicularOffset;
                    }

                    if (_currentPlacementParent == null) _currentPlacementParent = InstantiatePlacementParent(pointOnCircle);
                    if (IsValidPlacement(pointOnCircle, lineBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid))
                    {
                        GameObject placedObject = Instantiate(_currentActiveLinePlacementPrefab, pointOnCircle, objectRotation, _currentPlacementParent.transform);
                        placedLineObjects.Add(placedObject);
                        if (_currentSelectedEntry.occupyGrid) _occupiedGridCells.Add(WorldToGrid(pointOnCircle));
                    }
                }
            }

            if (_currentSelectedEntry.combineLineMeshes && placedLineObjects.Count > 1)
            {
                CombineMeshes(placedLineObjects, "CombinedCircleLineMesh");
            }
            Debug.Log($"Placed {placedLineObjects.Count} circle perimeter objects.");
        }

        // Place fill objects if fill prefab is available
        if (hasFillPrefab)
        {
            Vector3 fillBoundsExtents = _currentSelectedEntry.fillBuildingInfo != null ? _currentSelectedEntry.fillBuildingInfo.buildingBoundsExtents : Vector3.one * 0.5f;
            List<GameObject> placedFillObjects = PlaceObjectsInCircleFill(_circleCenter, _circleRadius, _currentActiveFillPlacementPrefab, fillBoundsExtents, fillObjectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
            if (_currentSelectedEntry.combineFillMeshes && placedFillObjects.Count > 1)
            {
                CombineMeshes(placedFillObjects, "CombinedCircleFillMesh");
            }
            Debug.Log($"Placed {placedFillObjects.Count} circle fill objects.");
        }

        // Reset circle drawing state immediately after placement
        _isDrawingCircle = false;
        _circleRadius = 0;
        // Assuming the main LineRenderer might also be used for circle preview, disable it
        GetComponent<LineRenderer>().enabled = false;
        currentState = LinePlacementState.Idle; // Return to idle state after placement

        if (!_currentSelectedEntry.isContinuous) ExitPlacementMode();
    }


    // Generic helper for placing objects along a box perimeter (used by combined and dedicated box line modes)
    private List<GameObject> PlaceObjectsAlongBoxPerimeter(Vector3 minCorner, Vector3 maxCorner, GameObject prefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        List<GameObject> placedObjects = new List<GameObject>();
        if (prefab == null) return placedObjects;

        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2;
        float effectiveObjectSize = objectLength + spacing;

        List<Vector3> boxCorners = new List<Vector3>()
        {
            new Vector3(minCorner.x, 0, minCorner.z),
            new Vector3(maxCorner.x, 0, minCorner.z),
            new Vector3(maxCorner.x, 0, maxCorner.z),
            new Vector3(minCorner.x, 0, maxCorner.z),
            new Vector3(minCorner.x, 0, minCorner.z) // Close the loop
        };

        float currentPathDistance = 0f;
        float nextObjectDistanceTarget = effectiveObjectSize / 2f;

        for (int i = 0; i < boxCorners.Count - 1; i++)
        {
            Vector3 currentSegmentStart = boxCorners[i];
            Vector3 currentSegmentEnd = boxCorners[i + 1];
            float segmentLength = Vector3.Distance(currentSegmentStart, currentSegmentEnd);

            if (segmentLength < 0.001f) continue;

            RaycastHit hitStart, hitEnd;
            if (RaycastToTerrain(currentSegmentStart + Vector3.up * terrainRaycastStartHeight, out hitStart, placementLayerMask)) currentSegmentStart.y = hitStart.point.y;
            if (RaycastToTerrain(currentSegmentEnd + Vector3.up * terrainRaycastStartHeight, out hitEnd, placementLayerMask)) currentSegmentEnd.y = hitEnd.point.y;


            while (currentPathDistance + segmentLength >= nextObjectDistanceTarget)
            {
                float distanceIntoSegment = nextObjectDistanceTarget - currentPathDistance;
                Vector3 objectPosition = Vector3.Lerp(currentSegmentStart, currentSegmentEnd, distanceIntoSegment / segmentLength);

                RaycastHit hit;
                if (RaycastToTerrain(objectPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    objectPosition.y = hit.point.y;
                }
                else
                {
                    nextObjectDistanceTarget += effectiveObjectSize;
                    continue;
                }

                Vector3 direction = (currentSegmentEnd - currentSegmentStart).normalized;
                if (direction == Vector3.zero) direction = Vector3.forward;

                Quaternion objectRotation = Quaternion.LookRotation(direction);
                if (objectsRotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0);
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    objectPosition += perpendicularOffset;
                }

                if (_currentPlacementParent == null) _currentPlacementParent = InstantiatePlacementParent(objectPosition);
                if (IsValidPlacement(objectPosition, boundsExtents, canOverlap, occupyGrid))
                {
                    GameObject placedObject = Instantiate(prefab, objectPosition, objectRotation, _currentPlacementParent.transform);
                    placedObjects.Add(placedObject);
                    if (occupyGrid) _occupiedGridCells.Add(WorldToGrid(objectPosition));
                }
                nextObjectDistanceTarget += effectiveObjectSize;
            }
            currentPathDistance += segmentLength;
        }
        return placedObjects;
    }

    // Generic helper for placing objects in a box fill (used by combined and dedicated box fill modes)
    private List<GameObject> PlaceObjectsInBoxFill(Vector3 minCorner, Vector3 maxCorner, GameObject prefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        List<GameObject> placedObjects = new List<GameObject>();
        if (prefab == null) return placedObjects;

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;

        float effectiveWidth = objectWidth + spacing;
        float effectiveLength = objectLength + spacing;

        for (float z = minCorner.z + effectiveLength / 2f; z < maxCorner.z - effectiveLength / 4f; z += effectiveLength)
        {
            for (float x = minCorner.x + effectiveWidth / 2f; x < maxCorner.x - effectiveWidth / 4f; x += effectiveWidth)
            {
                Vector3 objectPosition = new Vector3(x, minCorner.y, z);

                RaycastHit hit;
                if (RaycastToTerrain(objectPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    objectPosition.y = hit.point.y;
                }
                else
                {
                    continue;
                }

                if (_currentPlacementParent == null) _currentPlacementParent = InstantiatePlacementParent(objectPosition);
                if (IsValidPlacement(objectPosition, boundsExtents, canOverlap, occupyGrid))
                {
                    GameObject placedObject = Instantiate(prefab, objectPosition, Quaternion.identity, _currentPlacementParent.transform);
                    placedObjects.Add(placedObject);
                    if (occupyGrid) _occupiedGridCells.Add(WorldToGrid(objectPosition));
                }
            }
        }
        return placedObjects;
    }

    // Generic helper for placing objects in a polygon fill (used by LineLoopFill)
    private List<GameObject> PlaceObjectsInPolygonFill(List<Vector3> polygonPoints, GameObject prefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        List<GameObject> placedObjects = new List<GameObject>();
        if (prefab == null || polygonPoints.Count < 3) return placedObjects;

        List<Vector2> polygon2D = polygonPoints.Select(p => new Vector2(p.x, p.z)).ToList();

        float minX = polygonPoints.Min(p => p.x);
        float maxX = polygonPoints.Max(p => p.x);
        float minZ = polygonPoints.Min(p => p.z);
        float maxZ = polygonPoints.Max(p => p.z);

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;
        float effectiveWidth = objectWidth + spacing;
        float effectiveLength = objectLength + spacing;

        for (float x = minX + effectiveWidth / 2f; x < maxX; x += effectiveWidth)
        {
            for (float z = minZ + effectiveLength / 2f; z < maxZ; z += effectiveLength)
            {
                Vector3 objectPosition = new Vector3(x, 0, z);

                if (IsPointInPolygon(new Vector2(objectPosition.x, objectPosition.z), polygon2D))
                {
                    RaycastHit hit;
                    if (RaycastToTerrain(objectPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        objectPosition.y = hit.point.y;
                    }
                    else
                    {
                        continue;
                    }

                    if (_currentPlacementParent == null) _currentPlacementParent = InstantiatePlacementParent(objectPosition);
                    if (IsValidPlacement(objectPosition, boundsExtents, canOverlap, occupyGrid))
                    {
                        GameObject placedObject = Instantiate(prefab, objectPosition, Quaternion.identity, _currentPlacementParent.transform);
                        placedObjects.Add(placedObject);
                        if (occupyGrid) _occupiedGridCells.Add(WorldToGrid(objectPosition));
                    }
                }
            }
        }
        return placedObjects;
    }

    // Generic helper for placing objects in a circle fill (used by LineCircleFill)
    private List<GameObject> PlaceObjectsInCircleFill(Vector3 center, float radius, GameObject prefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        List<GameObject> placedObjects = new List<GameObject>();
        if (prefab == null) return placedObjects;

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;
        float effectiveSpacing = Mathf.Max(objectWidth, objectLength) + spacing;

        for (float r = 0; r <= radius; r += effectiveSpacing)
        {
            float currentCircumference = 2 * Mathf.PI * r;
            int numObjectsAtRadius = (r == 0) ? 1 : Mathf.Max(1, Mathf.FloorToInt(currentCircumference / effectiveSpacing));

            for (int i = 0; i < numObjectsAtRadius; i++)
            {
                float angle = (i * 360f / numObjectsAtRadius) * Mathf.Deg2Rad;
                Vector3 objectPosition = center + new Vector3(Mathf.Cos(angle) * r, 0, Mathf.Sin(angle) * r);

                RaycastHit hit;
                if (RaycastToTerrain(objectPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    objectPosition.y = hit.point.y;
                }
                else
                {
                    continue;
                }

                if (_currentPlacementParent == null) _currentPlacementParent = InstantiatePlacementParent(objectPosition);
                if (IsValidPlacement(objectPosition, boundsExtents, canOverlap, occupyGrid))
                {
                    GameObject placedObject = Instantiate(prefab, objectPosition, Quaternion.identity, _currentPlacementParent.transform);
                    placedObjects.Add(placedObject);
                    if (occupyGrid) _occupiedGridCells.Add(WorldToGrid(objectPosition));
                }
            }
        }
        return placedObjects;
    }


    // New method to combine meshes
    private void CombineMeshes(List<GameObject> objectsToCombine, string combinedObjectName)
    {
        if (objectsToCombine == null || objectsToCombine.Count <= 1)
        {
            if (objectsToCombine != null && objectsToCombine.Count == 1)
            {
                objectsToCombine[0].name = combinedObjectName; // Just rename if only one
            }
            return;
        }

        MeshFilter[] meshFilters = new MeshFilter[objectsToCombine.Count];
        for (int i = 0; i < objectsToCombine.Count; i++)
        {
            meshFilters[i] = objectsToCombine[i].GetComponent<MeshFilter>();
            if (meshFilters[i] == null)
            {
                Debug.LogWarning($"Object {objectsToCombine[i].name} does not have a MeshFilter. Skipping combination.");
                return;
            }
        }

        CombineInstance[] combine = new CombineInstance[meshFilters.Length];

        for (int i = 0; i < meshFilters.Length; i++)
        {
            if (meshFilters[i] == null) continue; // Skip if MeshFilter is null
            combine[i].mesh = meshFilters[i].sharedMesh;
            combine[i].transform = meshFilters[i].transform.localToWorldMatrix;
            // The original objects will be destroyed after combination, so remove them from the list
            Destroy(meshFilters[i].gameObject);
        }

        GameObject combinedObject = new GameObject(combinedObjectName);
        combinedObject.transform.SetParent(_currentPlacementParent?.transform); // Parent to the current placement parent
        combinedObject.AddComponent<MeshFilter>().mesh = new Mesh();
        combinedObject.GetComponent<MeshFilter>().mesh.CombineMeshes(combine);
        combinedObject.AddComponent<MeshRenderer>().material = meshFilters[0]?.GetComponent<MeshRenderer>()?.sharedMaterial; // Use the material from the first object

        // Ensure the combined object has a collider if the original objects had one.
        // This is a basic example; more complex collider merging might be needed.
        Collider originalCollider = objectsToCombine[0]?.GetComponent<Collider>();
        if (originalCollider != null)
        {
            if (originalCollider is BoxCollider)
            {
                combinedObject.AddComponent<BoxCollider>();
                // You would need to calculate the bounds of the combined mesh to set the collider size accurately
            }
            else if (originalCollider is MeshCollider)
            {
                MeshCollider newMeshCollider = combinedObject.AddComponent<MeshCollider>();
                newMeshCollider.sharedMesh = combinedObject.GetComponent<MeshFilter>().sharedMesh;
                newMeshCollider.convex = true; // Often required for non-kinematic mesh colliders
            }
        }
        Debug.Log($"Combined {objectsToCombine.Count} meshes into {combinedObjectName}.");
    }

