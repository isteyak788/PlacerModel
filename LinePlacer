    private void DisableVisualAids()
    {
        // Get the LineRenderer component attached to this GameObject
        LineRenderer internalLineRenderer = GetComponent<LineRenderer>();
        if (internalLineRenderer != null)
        {
            internalLineRenderer.enabled = false;
            internalLineRenderer.positionCount = 0; // Clear all points
        }

        if (boxPreviewLineRenderer != null)
        {
            boxPreviewLineRenderer.enabled = false;
            boxPreviewLineRenderer.positionCount = 0;
        }
        ClearObjectPreviews();
    }

    // Added optional parameter to control parent destruction
    public void ExitPlacementMode(bool forceDestroyParent = true)
    {
        currentState = LinePlacementState.Idle;
        _currentActiveMode = ActivePlacementMode.None;
        _currentSelectedEntry = null;
        _currentActiveLinePlacementPrefab = null;
        _currentActiveLineGhostPrefab = null;
        _currentActiveFillPlacementPrefab = null;
        _currentActiveFillGhostPrefab = null;
        linePoints.Clear(); // Ensure points are cleared on full exit
        DisableVisualAids(); // Ensure visual aids are disabled on full exit
        _isDraggingBox = false;
        _isDrawingCircle = false;
        _circleRadius = 0;

        // Destroy the current placement parent ONLY if forced or if it has no children
        // (meaning no objects were successfully placed in it)
        if (_currentPlacementParent != null)
        {
            if (forceDestroyParent || _currentPlacementParent.transform.childCount == 0)
            {
                Destroy(_currentPlacementParent);
            }
            // If not destroyed, just nullify the reference so a new one is made next time
            _currentPlacementParent = null;
        }

        SetAllPlacementButtonsInteractable(true);

        Debug.Log("Placement Mode Exited. Select a placement option via buttons.");
    }

    // New: Instantiates a parent GameObject for newly placed objects
    // It now takes an initial position.
    private GameObject InstantiatePlacementParent(Vector3 initialPosition)
    {
        GameObject parent;
        if (parentObjectPrefab != null)
        {
            parent = Instantiate(parentObjectPrefab, initialPosition, Quaternion.identity);
            parent.name = parentObjectPrefab.name + "_Parent_Placed";
        }
        else
        {
            parent = new GameObject("Placed_Objects_Parent");
            parent.transform.position = initialPosition;
        }
        return parent;
    }

    void Update()
    {
        UpdateMouseWorldPosition();

        switch (currentState)
        {
            case LinePlacementState.Idle:
                if (_currentActiveMode != ActivePlacementMode.None)
                {
                    HandleInitialInput();
                }
                break;
            case LinePlacementState.DrawingLine:
                HandleDrawingLineInput();
                // Pass true for closedLoop if it's a loop mode, and if there are enough points
                bool isLoopMode = (_currentActiveMode == ActivePlacementMode.LineLoop || _currentActiveMode == ActivePlacementMode.LineLoopFill) && linePoints.Count >= 3;
                UpdateLineObjectPreviews(isLoopMode);
                break;
            case LinePlacementState.DrawingBox:
                HandleDrawingBoxInput();
                UpdateBoxPreview();
                UpdateBoxObjectPreviews();
                break;
            case LinePlacementState.DrawingCircle:
                HandleDrawingCircleInput();
                UpdateCircleObjectPreviews();
                break;
        }
    }

    private void UpdateMouseWorldPosition()
    {
        Ray ray = Camera.main.ScreenPointToRay(Input.mousePosition);
        if (Physics.Raycast(ray, out RaycastHit hit, Mathf.Infinity, placementLayerMask))
        {
            _mouseWorldPosition = hit.point;
            _mouseWorldPositionFound = true;
        }
        else
        {
            _mouseWorldPositionFound = false;
        }
    }

    private bool IsPointerOverUIObject()
    {
        PointerEventData eventDataCurrentPosition = new PointerEventData(EventSystem.current);
        eventDataCurrentPosition.position = new Vector2(Input.mousePosition.x, Input.mousePosition.y);
        List<RaycastResult> results = new List<RaycastResult>();
        EventSystem.current.RaycastAll(eventDataCurrentPosition, results);
        return results.Count > 0;
    }

    private void HandleInitialInput()
    {
        if (IsPointerOverUIObject()) return;

        if (Input.GetMouseButtonDown(0))
        {
            if (_mouseWorldPositionFound)
            {
                if (_currentActiveMode == ActivePlacementMode.Box || _currentActiveMode == ActivePlacementMode.BoxLine || _currentActiveMode == ActivePlacementMode.BoxFill)
                {
                    _boxDrawStartPoint = _mouseWorldPosition;
                    _isDraggingBox = true;
                    currentState = LinePlacementState.DrawingBox;
                    Debug.Log("Started box drawing. Drag to define area, release to place.");
                    if (boxPreviewLineRenderer != null) boxPreviewLineRenderer.enabled = true;
                }
                else if (_currentActiveMode == ActivePlacementMode.Line || _currentActiveMode == ActivePlacementMode.LineLoop || _currentActiveMode == ActivePlacementMode.LineLoopFill)
                {
                    linePoints.Add(_mouseWorldPosition);
                    currentState = LinePlacementState.DrawingLine;
                    Debug.Log("First line point placed. Continue clicking to add more points.");
                }
                else if (_currentActiveMode == ActivePlacementMode.LineCircle || _currentActiveMode == ActivePlacementMode.LineCircleFill)
                {
                    _circleCenter = _mouseWorldPosition;
                    _isDrawingCircle = true;
                    currentState = LinePlacementState.DrawingCircle;
                    Debug.Log("Circle center set. Drag mouse to define radius, then click again to finalize.");
                }
                else
                {
                    Debug.LogWarning("No active placement mode. Please select an option first.");
                    ExitPlacementMode();
                }
            }
        }
        else if (Input.GetMouseButtonDown(1))
        {
            // When cancelling during Idle state, always destroy the parent if it's empty
            ExitPlacementMode(forceDestroyParent: true);
        }
    }

    private void HandleDrawingLineInput()
    {
        if (Input.GetMouseButtonDown(0) && !IsPointerOverUIObject())
        {
            if (_mouseWorldPositionFound)
            {
                if (linePoints.Count == 0 || Vector3.Distance(linePoints.Last(), _mouseWorldPosition) > minSegmentLengthForObject)
                {
                    linePoints.Add(_mouseWorldPosition);
                    Debug.Log($"Point {linePoints.Count} added. Current points: {linePoints.Count}. Press Enter to finalize line.");
                }
                else
                {
                    Debug.Log("Point too close to the previous one. Minimum segment length: " + minSegmentLengthForObject);
                }
            }
        }
        else if (Input.GetKeyDown(KeyCode.Return))
        {
            if (linePoints.Count >= 2)
            {
                if (_currentActiveMode == ActivePlacementMode.Line)
                {
                    PlaceAllObjectsFromLine();
                }
                else
                {
                    if (linePoints.Count >= 3) // Need at least 3 points for a meaningful loop
                    {
                        if (_currentActiveMode == ActivePlacementMode.LineLoop)
                        {
                            PlaceAllObjectsFromLineLoop();
                        }
                        else if (_currentActiveMode == ActivePlacementMode.LineLoopFill)
                        {
                            PlaceAllObjectsFromLineLoopFill();
                        }
                    }
                    else
                    {
                        Debug.Log("Need at least 3 points to finalize a line loop/loop fill for placement.");
                    }
                }
            }
            else
            {
                Debug.Log("Need at least 2 points to finalize a line for placement.");
            }
        }
        else if (Input.GetMouseButtonDown(1) && !IsPointerOverUIObject())
        {
            if (linePoints.Count > 1)
            {
                linePoints.RemoveAt(linePoints.Count - 1);
                Debug.Log("Last point removed. Current points: " + linePoints.Count);
            }
            else if (linePoints.Count == 1)
            {
                linePoints.Clear();
                currentState = LinePlacementState.Idle; // Go back to idle to allow fresh start
                Debug.Log("First point cleared. Back to waiting for first point.");
                // If only one point was placed and now cleared, and it's not continuous, destroy parent.
                if (!_currentSelectedEntry.isContinuous && _currentPlacementParent != null && _currentPlacementParent.transform.childCount == 0)
                {
                    Destroy(_currentPlacementParent);
                    _currentPlacementParent = null;
                }
            }
            else
            {
                ExitPlacementMode();
            }
        }
    }

    private void HandleDrawingBoxInput()
    {
        if (IsPointerOverUIObject()) return;

        if (Input.GetMouseButtonUp(0))
        {
            // _isDraggingBox will be set to false in the placement methods below
            if (_mouseWorldPositionFound)
            {
                Vector3 currentMousePoint = _mouseWorldPosition;
                Vector3 minCorner = new Vector3(Mathf.Min(_boxDrawStartPoint.x, currentMousePoint.x), _boxDrawStartPoint.y, Mathf.Min(_boxDrawStartPoint.z, currentMousePoint.z));
                Vector3 maxCorner = new Vector3(Mathf.Max(_boxDrawStartPoint.x, currentMousePoint.x), _boxDrawStartPoint.y, Mathf.Max(_boxDrawStartPoint.z, currentMousePoint.z));

                float boxWidth = Mathf.Abs(maxCorner.x - minCorner.x);
                float boxLength = Mathf.Abs(maxCorner.z - minCorner.z);

                if (boxWidth >= minBoxSize && boxLength >= minBoxSize)
                {
                    if (_currentActiveMode == ActivePlacementMode.Box)
                    {
                        PlaceAllObjectsFromCombinedBox(minCorner, maxCorner);
                    }
                    else if (_currentActiveMode == ActivePlacementMode.BoxLine)
                    {
                        PlaceAllObjectsFromBoxLine(minCorner, maxCorner);
                    }
                    else
                    {
                        // Explicitly check for BoxFill before calling PlaceAllObjectsFromBoxFill
                        if (_currentActiveMode == ActivePlacementMode.BoxFill)
                        {
                            PlaceAllObjectsFromBoxFill(minCorner, maxCorner);
                        }
                    }
                }
                else
                {
                    Debug.LogWarning($"Box too small. Minimum size: {minBoxSize}x{minBoxSize}. Current: {boxWidth:F2}x{boxLength:F2}.");
                    ExitPlacementMode();
                }
            }
            else
            {
                ExitPlacementMode();
            }
        }
        else if (Input.GetMouseButtonDown(1))
        {
            ExitPlacementMode();
        }
    }

    // Handle drawing a circle
    private void HandleDrawingCircleInput()
    {
        if (IsPointerOverUIObject()) return;

        if (_mouseWorldPositionFound)
        {
            _circleRadius = Vector3.Distance(_circleCenter, _mouseWorldPosition);
        }

        if (Input.GetMouseButtonDown(0))
        {
            if (_mouseWorldPositionFound)
            {
                if (_circleRadius > minBoxSize) // Reuse minBoxSize as minCircleRadius
                {
                    if (_currentActiveMode == ActivePlacementMode.LineCircle)
                    {
                        PlaceObjectsInCircle(); // Finalize and place circle objects
                    }
                    else if (_currentActiveMode == ActivePlacementMode.LineCircleFill)
                    {
                        PlaceAllObjectsFromLineCircleFill(); // Finalize and place circle fill objects
                    }
                }
                else
                {
                    Debug.LogWarning($"Circle radius too small. Minimum radius: {minBoxSize}. Current: {_circleRadius:F2}.");
                    ExitPlacementMode();
                }
            }
        }
        else if (Input.GetMouseButtonDown(1))
        {
            ExitPlacementMode();
        }
    }


    private void UpdateBoxPreview()
    {
        if (boxPreviewLineRenderer == null || !_isDraggingBox || !_mouseWorldPositionFound)
        {
            if (boxPreviewLineRenderer != null) boxPreviewLineRenderer.enabled = false;
            return;
        }

        boxPreviewLineRenderer.enabled = true;

        Vector3 currentMousePoint = _mouseWorldPosition;
        float previewY = _boxDrawStartPoint.y;

        Vector3 p1 = new Vector3(_boxDrawStartPoint.x, previewY, _boxDrawStartPoint.z);
        Vector3 p2 = new Vector3(currentMousePoint.x, previewY, _boxDrawStartPoint.z);
        Vector3 p3 = new Vector3(currentMousePoint.x, previewY, currentMousePoint.z);
        Vector3 p4 = new Vector3(_boxDrawStartPoint.x, previewY, currentMousePoint.z);

        RaycastHit hit;
        if (RaycastToTerrain(p1 + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask)) p1.y = hit.point.y;
        if (RaycastToTerrain(p2 + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask)) p2.y = hit.point.y;
        if (RaycastToTerrain(p3 + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask)) p3.y = hit.point.y;
        if (RaycastToTerrain(p4 + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask)) p4.y = hit.point.y;

        Vector3[] corners = new Vector3[] { p1, p2, p3, p4, p1 };
        boxPreviewLineRenderer.positionCount = corners.Length;
        boxPreviewLineRenderer.SetPositions(corners);
    }

    // Updates live previews for objects within the box during drag
    private void UpdateBoxObjectPreviews()
    {
        ClearObjectPreviews();
        if (_currentSelectedEntry == null || !_currentSelectedEntry.showGhost || !_isDraggingBox || !_mouseWorldPositionFound) return;

        // Generate and show previews based on which prefabs are assigned for the current entry
        // Check _currentActiveLineGhostPrefab for null before using
        if ((_currentActiveMode == ActivePlacementMode.Box || _currentActiveMode == ActivePlacementMode.BoxLine) && _currentActiveLineGhostPrefab != null)
        {
            // Ensure lineBuildingInfo is not null before accessing its members
            Vector3 lineBoundsExtents = _currentSelectedEntry.lineBuildingInfo != null ? _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents : Vector3.one * 0.5f;
            GenerateBoxLinePreviews(GetCurrentBoxMinCorner(), GetCurrentBoxMaxCorner(), _currentActiveLineGhostPrefab, lineBoundsExtents, objectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
        }
        // Check _currentActiveFillGhostPrefab for null before using
        if ((_currentActiveMode == ActivePlacementMode.Box || _currentActiveMode == ActivePlacementMode.BoxFill) && _currentActiveFillGhostPrefab != null)
        {
            // Ensure fillBuildingInfo is not null before accessing its members
            Vector3 fillBoundsExtents = _currentSelectedEntry.fillBuildingInfo != null ? _currentSelectedEntry.fillBuildingInfo.buildingBoundsExtents : Vector3.one * 0.5f;
            GenerateBoxFillPreviews(GetCurrentBoxMinCorner(), GetCurrentBoxMaxCorner(), _currentActiveFillGhostPrefab, fillBoundsExtents, fillObjectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
        }
    }

    private Vector3 GetCurrentBoxMinCorner()
    {
        return new Vector3(Mathf.Min(_boxDrawStartPoint.x, _mouseWorldPosition.x), _boxDrawStartPoint.y, Mathf.Min(_boxDrawStartPoint.z, _mouseWorldPosition.z));
    }

    private Vector3 GetCurrentBoxMaxCorner()
    {
        return new Vector3(Mathf.Max(_boxDrawStartPoint.x, _mouseWorldPosition.x), _boxDrawStartPoint.y, Mathf.Max(_boxDrawStartPoint.z, _mouseWorldPosition.z));
    }


    // Updates live previews for objects along the circumference of a circle
    private void UpdateCircleObjectPreviews()
    {
        ClearObjectPreviews();
        if (_currentSelectedEntry == null || !_currentSelectedEntry.showGhost || !_isDrawingCircle || !_mouseWorldPositionFound || _circleRadius <= 0) return;

        // Check _currentActiveLineGhostPrefab for null before using
        if ((_currentActiveMode == ActivePlacementMode.LineCircle || _currentActiveMode == ActivePlacementMode.LineCircleFill) && _currentActiveLineGhostPrefab != null)
        {
            // Ensure lineBuildingInfo is not null before accessing its members
            Vector3 lineBoundsExtents = _currentSelectedEntry.lineBuildingInfo != null ? _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents : Vector3.one * 0.5f;
            float objectLength = lineBoundsExtents.z * 2;
            float objectWidth = lineBoundsExtents.x * 2;
            float effectiveObjectSize = objectLength + objectSpacing; // Calculate effective size including spacing

            // Calculate circumference
            float circumference = 2 * Mathf.PI * _circleRadius;
            int numberOfObjects = Mathf.FloorToInt(circumference / effectiveObjectSize);

            if (numberOfObjects > 0)
            {
                float angleStep = 360f / numberOfObjects;
                for (int i = 0; i < numberOfObjects; i++)
                {
                    float angle = i * angleStep;
                    Vector3 pointOnCircle = _circleCenter + new Vector3(Mathf.Cos(Mathf.Deg2Rad * angle), 0, Mathf.Sin(Mathf.Deg2Rad * angle)) * _circleRadius;

                    RaycastHit hit;
                    if (RaycastToTerrain(pointOnCircle + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        pointOnCircle.y = hit.point.y;
                    }
                    else
                    {
                        continue; // Skip placement if no terrain found
                    }

                    Vector3 direction = (pointOnCircle - _circleCenter).normalized; // Direction from center to object
                    Quaternion objectRotation = Quaternion.LookRotation(direction);
                    if (objectsRotatedRightOfLine)
                    {
                        objectRotation *= Quaternion.Euler(0, 90, 0); // Rotate 90 degrees relative to the radial direction
                        Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                        pointOnCircle += perpendicularOffset;
                    }

                    bool isValid = IsValidPlacement(pointOnCircle, lineBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
                    GameObject preview = Instantiate(_currentActiveLineGhostPrefab, pointOnCircle, objectRotation);
                    currentObjectPreviews.Add(preview);
                    SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
                }
            }
        }
        // NEW: If LineCircleFill, also show a preview of the fill. Check _currentActiveFillGhostPrefab for null.
        if (_currentActiveMode == ActivePlacementMode.LineCircleFill && _currentActiveFillGhostPrefab != null)
        {
            // Ensure fillBuildingInfo is not null before accessing its members
            Vector3 fillBoundsExtents = _currentSelectedEntry.fillBuildingInfo != null ? _currentSelectedEntry.fillBuildingInfo.buildingBoundsExtents : Vector3.one * 0.5f;
            GenerateCircleFillPreviews(_circleCenter, _circleRadius, _currentActiveFillGhostPrefab, fillBoundsExtents, fillObjectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
        }
    }

    // NEW: Method to update live previews for objects along a line, including loops
    private void UpdateLineObjectPreviews(bool isClosedLoop)
    {
        ClearObjectPreviews();
        if (_currentSelectedEntry == null || !_currentSelectedEntry.showGhost || linePoints.Count < 1 || !_mouseWorldPositionFound) return;

        // Check which ghost prefab to use for line objects (perimeter)
        GameObject lineGhostPrefab = _currentActiveLineGhostPrefab;
        // Check which ghost prefab to use for fill objects (interior)
        GameObject fillGhostPrefab = _currentActiveFillGhostPrefab;

        // Ensure BuildingInfo for line objects is available if needed
        Vector3 lineBoundsExtents = (_currentSelectedEntry.lineBuildingInfo != null && lineGhostPrefab != null) ? _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents : Vector3.one * 0.5f;
        float objectLength = lineBoundsExtents.z * 2;
        float objectWidth = lineBoundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        List<Vector3> currentPath = new List<Vector3>(linePoints);
        if (linePoints.Count > 0)
        {
            // Add the current mouse position as the potential next point
            currentPath.Add(_mouseWorldPosition);
        }

        if (currentPath.Count < 2) return; // Only generate previews if there are enough points for the current mode

        // Handle line perimeter previews
        if (lineGhostPrefab != null && (_currentActiveMode == ActivePlacementMode.Line || _currentActiveMode == ActivePlacementMode.LineLoop || _currentActiveMode == ActivePlacementMode.LineLoopFill))
        {
            if (_currentActiveMode == ActivePlacementMode.Line && currentPath.Count < 2) return;
            if ((_currentActiveMode == ActivePlacementMode.LineLoop || _currentActiveMode == ActivePlacementMode.LineLoopFill) && currentPath.Count < 3) return;


            List<Vector3> interpolatedPoints = new List<Vector3>();

            // Generate interpolated points for smooth curves
            for (int i = 0; i < currentPath.Count - 1; i++)
            {
                Vector3 p0 = i == 0 ? currentPath[0] : currentPath[i - 1]; // Use first point twice if at start
                Vector3 p1 = currentPath[i];
                Vector3 p2 = currentPath[i + 1];
                Vector3 p3 = (i + 2 >= currentPath.Count) ? currentPath[currentPath.Count - 1] : currentPath[i + 2]; // Use last point twice if at end

                for (int j = 0; j <= curveResolution; j++)
                {
                    float t = (float)j / curveResolution;
                    // Catmull-Rom spline interpolation
                    Vector3 interpolatedPoint = GetCatmullRomPosition(t, p0, p1, p2, p3);

                    RaycastHit hit;
                    if (RaycastToTerrain(interpolatedPoint + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        interpolatedPoint.y = hit.point.y;
                    }
                    else
                    {
                        // If raycast fails, use the original point's Y or some fallback
                        interpolatedPoint.y = p1.y; // Fallback to start point's Y
                    }
                    interpolatedPoints.Add(interpolatedPoint);
                }
            }

            // If it's a closed loop, add points from last to first for preview
            if (isClosedLoop && currentPath.Count >= 3)
            {
                Vector3 p0 = currentPath[currentPath.Count - 2];
                Vector3 p1 = currentPath[currentPath.Count - 1];
                Vector3 p2 = currentPath[0];
                Vector3 p3 = currentPath[1];
                for (int j = 0; j <= curveResolution; j++)
                {
                    float t = (float)j / curveResolution;
                    Vector3 interpolatedPoint = GetCatmullRomPosition(t, p0, p1, p2, p3);
                    RaycastHit hit;
                    if (RaycastToTerrain(interpolatedPoint + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        interpolatedPoint.y = hit.point.y;
                    }
                    else
                    {
                        interpolatedPoint.y = p1.y;
                    }
                    interpolatedPoints.Add(interpolatedPoint);
                }
            }

            float currentPathDistance = 0f;
            float nextObjectDistanceTarget = effectiveObjectSize / 2f; // Start placement at half an object size to center the first object on the segment

            for (int i = 0; i < interpolatedPoints.Count - 1; i++)
            {
                Vector3 startPoint = interpolatedPoints[i];
                Vector3 endPoint = interpolatedPoints[i + 1];
                float segmentLength = Vector3.Distance(startPoint, endPoint);
                Vector3 segmentDirection = (endPoint - startPoint).normalized;

                while (currentPathDistance + segmentLength >= nextObjectDistanceTarget)
                {
                    float distanceIntoSegment = nextObjectDistanceTarget - currentPathDistance;
                    if (segmentLength < 0.001f && distanceIntoSegment > 0) break; // Avoid division by zero for very short segments

                    Vector3 previewPosition = Vector3.Lerp(startPoint, endPoint, distanceIntoSegment / segmentLength);

                    // Raycast preview position to terrain
                    RaycastHit hit;
                    if (RaycastToTerrain(previewPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        previewPosition.y = hit.point.y;
                    }
                    else
                    {
                        nextObjectDistanceTarget += effectiveObjectSize;
                        continue; // Skip placement if no terrain found
                    }

                    Quaternion objectRotation = Quaternion.LookRotation(segmentDirection);
                    if (objectsRotatedRightOfLine)
                    {
                        objectRotation *= Quaternion.Euler(0, 90, 0);
                        Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                        previewPosition += perpendicularOffset;
                    }

                    bool isValid = IsValidPlacement(previewPosition, lineBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
                    GameObject preview = Instantiate(lineGhostPrefab, previewPosition, objectRotation);
                    currentObjectPreviews.Add(preview);
                    SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);

                    nextObjectDistanceTarget += effectiveObjectSize;
                }
                currentPathDistance += segmentLength;
            }
        }

        // If LineLoopFill, also show a preview of the fill.
        if (_currentActiveMode == ActivePlacementMode.LineLoopFill && currentPath.Count >= 3 && fillGhostPrefab != null)
        {
            // Ensure fillBuildingInfo is not null before accessing its members
            Vector3 fillBoundsExtents = _currentSelectedEntry.fillBuildingInfo != null ? _currentSelectedEntry.fillBuildingInfo.buildingBoundsExtents : Vector3.one * 0.5f;
            GenerateFillPreviewsInPolygon(currentPath, fillGhostPrefab, fillBoundsExtents, fillObjectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
        }
    }


    // Helper to generate previews along a box's perimeter
    private void GenerateBoxLinePreviews(Vector3 minCorner, Vector3 maxCorner, GameObject prefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool canOccupyGrid)
    {
        if (prefab == null) return;

        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2;
        float effectiveObjectSize = objectLength + spacing;

        List<Vector3> boxCorners = new List<Vector3>()
        {
            new Vector3(minCorner.x, 0, minCorner.z),
            new Vector3(maxCorner.x, 0, minCorner.z),
            new Vector3(maxCorner.x, 0, maxCorner.z),
            new Vector3(minCorner.x, 0, maxCorner.z),
            new Vector3(minCorner.x, 0, minCorner.z) // Close the loop
        };

        float currentPathDistance = 0f;
        // Start placement at half an object size to center the first object on the segment or corner
        float nextObjectDistanceTarget = effectiveObjectSize / 2f;

        for (int i = 0; i < boxCorners.Count - 1; i++)
        {
            Vector3 currentSegmentStart = boxCorners[i];
            Vector3 currentSegmentEnd = boxCorners[i + 1];
            float segmentLength = Vector3.Distance(currentSegmentStart, currentSegmentEnd);

            if (segmentLength < 0.001f) continue; // Skip very short segments

            // Adjust segment points to terrain height
            RaycastHit hitStart, hitEnd;
            if (RaycastToTerrain(currentSegmentStart + Vector3.up * terrainRaycastStartHeight, out hitStart, placementLayerMask)) currentSegmentStart.y = hitStart.point.y;
            if (RaycastToTerrain(currentSegmentEnd + Vector3.up * terrainRaycastStartHeight, out hitEnd, placementLayerMask)) currentSegmentEnd.y = hitEnd.point.y;


            while (currentPathDistance + segmentLength >= nextObjectDistanceTarget)
            {
                float distanceIntoSegment = nextObjectDistanceTarget - currentPathDistance;
                Vector3 previewPosition = Vector3.Lerp(currentSegmentStart, currentSegmentEnd, distanceIntoSegment / segmentLength);

                // Raycast preview position to terrain
                RaycastHit hit;
                if (RaycastToTerrain(previewPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    previewPosition.y = hit.point.y;
                }
                else
                {
                    nextObjectDistanceTarget += effectiveObjectSize;
                    continue; // Skip placement if no terrain found
                }

                Vector3 direction = (currentSegmentEnd - currentSegmentStart).normalized;
                if (direction == Vector3.zero) direction = Vector3.forward; // Fallback if segment is too short

                Quaternion objectRotation = Quaternion.LookRotation(direction);
                if (objectsRotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0); // Rotate 90 degrees relative to the segment direction
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    previewPosition += perpendicularOffset;
                }

                bool isValid = IsValidPlacement(previewPosition, boundsExtents, canOverlap, canOccupyGrid);
                GameObject preview = Instantiate(prefab, previewPosition, objectRotation);
                currentObjectPreviews.Add(preview);
                SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);

                nextObjectDistanceTarget += effectiveObjectSize;
            }
            currentPathDistance += segmentLength;
        }
    }

    // Helper to generate previews for filling a box
    private void GenerateBoxFillPreviews(Vector3 minCorner, Vector3 maxCorner, GameObject prefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool canOccupyGrid)
    {
        if (prefab == null) return;

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;

        float effectiveWidth = objectWidth + spacing;
        float effectiveLength = objectLength + spacing;

        Vector3 currentFillPoint = new Vector3(minCorner.x + effectiveWidth / 2f, minCorner.y, minCorner.z + effectiveLength / 2f);

        for (float z = minCorner.z + effectiveLength / 2f; z < maxCorner.z - effectiveLength / 4f; z += effectiveLength)
        {
            for (float x = minCorner.x + effectiveWidth / 2f; x < maxCorner.x - effectiveWidth / 4f; x += effectiveWidth)
            {
                Vector3 previewPosition = new Vector3(x, minCorner.y, z);

                RaycastHit hit;
                if (RaycastToTerrain(previewPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    previewPosition.y = hit.point.y;
                }
                else
                {
                    continue; // Skip if no terrain found
                }

                bool isValid = IsValidPlacement(previewPosition, boundsExtents, canOverlap, canOccupyGrid);
                GameObject preview = Instantiate(prefab, previewPosition, Quaternion.identity);
                currentObjectPreviews.Add(preview);
                SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
            }
        }
    }

    // Helper to generate previews for filling a circle
    private void GenerateCircleFillPreviews(Vector3 center, float radius, GameObject prefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool canOccupyGrid)
    {
        if (prefab == null) return;

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;
        float effectiveSpacing = Mathf.Max(objectWidth, objectLength) + spacing; // Use the larger dimension for spacing

        // Iterate outwards from the center
        for (float r = 0; r <= radius; r += effectiveSpacing)
        {
            // Calculate circumference for the current radius to determine number of objects
            float currentCircumference = 2 * Mathf.PI * r;
            int numObjectsAtRadius = (r == 0) ? 1 : Mathf.Max(1, Mathf.FloorToInt(currentCircumference / effectiveSpacing));

            for (int i = 0; i < numObjectsAtRadius; i++)
            {
                float angle = (i * 360f / numObjectsAtRadius) * Mathf.Deg2Rad;
                Vector3 previewPosition = center + new Vector3(Mathf.Cos(angle) * r, 0, Mathf.Sin(angle) * r);

                RaycastHit hit;
                if (RaycastToTerrain(previewPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    previewPosition.y = hit.point.y;
                }
                else
                {
                    continue;
                }

                bool isValid = IsValidPlacement(previewPosition, boundsExtents, canOverlap, canOccupyGrid);
                GameObject preview = Instantiate(prefab, previewPosition, Quaternion.identity);
                currentObjectPreviews.Add(preview);
                SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
            }
        }
    }


    // Helper to generate previews for filling a polygon (for LineLoopFill)
    private void GenerateFillPreviewsInPolygon(List<Vector3> polygonPoints, GameObject prefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool canOccupyGrid)
    {
        if (prefab == null || polygonPoints.Count < 3) return;

        // Simplify the polygon points to 2D for easier calculations
        List<Vector2> polygon2D = polygonPoints.Select(p => new Vector2(p.x, p.z)).ToList();

        // Calculate bounding box of the polygon
        float minX = polygonPoints.Min(p => p.x);
        float maxX = polygonPoints.Max(p => p.x);
        float minZ = polygonPoints.Min(p => p.z);
        float maxZ = polygonPoints.Max(p => p.z);

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;
        float effectiveWidth = objectWidth + spacing;
        float effectiveLength = objectLength + spacing;

        // Iterate through a grid covering the bounding box
        for (float x = minX + effectiveWidth / 2f; x < maxX; x += effectiveWidth)
        {
            for (float z = minZ + effectiveLength / 2f; z < maxZ; z += effectiveLength)
            {
                Vector3 currentTestPoint = new Vector3(x, 0, z); // Y will be adjusted by raycast

                // Check if the point is inside the polygon
                if (IsPointInPolygon(new Vector2(currentTestPoint.x, currentTestPoint.z), polygon2D))
                {
                    RaycastHit hit;
                    if (RaycastToTerrain(currentTestPoint + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        currentTestPoint.y = hit.point.y;
                    }
                    else
                    {
                        continue; // Skip if no terrain found
                    }

                    bool isValid = IsValidPlacement(currentTestPoint, boundsExtents, canOverlap, canOccupyGrid);
                    GameObject preview = Instantiate(prefab, currentTestPoint, Quaternion.identity);
                    currentObjectPreviews.Add(preview);
                    SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
                }
            }
        }
    }

    // Point-in-polygon test (ray casting algorithm)
    private bool IsPointInPolygon(Vector2 point, List<Vector2> polygon)
    {
        int crossings = 0;
        int n = polygon.Count;
        for (int i = 0; i < n; i++)
        {
            Vector2 p1 = polygon[i];
            Vector2 p2 = polygon[(i + 1) % n];

            if (((p1.y <= point.y && point.y < p2.y) || (p2.y <= point.y && point.y < p1.y)) &&
                (point.x < (p2.x - p1.x) * (point.y - p1.y) / (p2.y - p1.y) + p1.x))
            {
                crossings++;
            }
        }
        return (crossings % 2 == 1);
    }


    private void ClearObjectPreviews()
    {
        foreach (GameObject preview in currentObjectPreviews)
        {
            Destroy(preview);
        }
        currentObjectPreviews.Clear();
    }

    private void SetPreviewMaterial(GameObject obj, Material material)
    {
        Renderer[] renderers = obj.GetComponentsInChildren<Renderer>(true);
        foreach (Renderer r in renderers)
        {
            r.material = material;
        }
    }

    // Function to check if a position is valid for placement
    private bool IsValidPlacement(Vector3 position, Vector3 boundsExtents, bool canOverlap, bool occupyGrid)
    {
        if (occupyGrid)
        {
            Vector2Int gridCell = WorldToGrid(position);
            if (_occupiedGridCells.Contains(gridCell))
            {
                return false; // Cell already occupied
            }
        }

        if (!canOverlap)
        {
            // Check for overlaps with existing colliders on the specified layer
            Collider[] hitColliders = Physics.OverlapBox(position, boundsExtents, Quaternion.identity, overlapCheckLayerMask);
            if (hitColliders.Length > 0)
            {
                return false; // Overlapping
            }
        }
        return true;
    }

    private Vector2Int WorldToGrid(Vector3 worldPos)
    {
        return new Vector2Int(Mathf.FloorToInt(worldPos.x / gridSize), Mathf.FloorToInt(worldPos.z / gridSize));
    }

    private void PlaceObject(GameObject prefab, Vector3 position, Quaternion rotation, Vector3 boundsExtents, bool occupyGrid, bool isLineObject)
    {
        if (prefab == null) return; // Don't place if prefab is null

        if (_currentPlacementParent == null)
        {
            _currentPlacementParent = InstantiatePlacementParent(position); // Create a new parent if one doesn't exist
        }

        bool isValid = IsValidPlacement(position, boundsExtents, _currentSelectedEntry.canOverlap, occupyGrid);

        if (isValid)
        {
            GameObject newObject = Instantiate(prefab, position, rotation, _currentPlacementParent.transform);
            newObject.name = prefab.name + "_Placed";

            if (occupyGrid)
            {
                // Mark occupied grid cells based on the object's bounds
                // This is a simplified approach assuming a single grid cell occupation for the object's center.
                // For more precise occupation, you might need to iterate over cells covered by the object's bounds.
                _occupiedGridCells.Add(WorldToGrid(position));
            }
        }
        else
        {
            // Optionally provide feedback for invalid placement
            // Debug.LogWarning($"Placement at {position} is invalid due to overlap or occupied grid.");
        }
    }


    // Function to get a point on a Catmull-Rom spline
    Vector3 GetCatmullRomPosition(float t, Vector3 p0, Vector3 p1, Vector3 p2, Vector3 p3)
    {
        // Catmull-Rom spline formula
        // t is normalized to [0, 1] for segment from p1 to p2
        return 0.5f * (
            (2.0f * p1) +
            (-p0 + p2) * t +
            (2.0f * p0 - 5.0f * p1 + 4.0f * p2 - p3) * t * t +
            (-p0 + 3.0f * p1 - 3.0f * p2 + p3) * t * t * t
        );
    }

    private bool RaycastToTerrain(Vector3 origin, out RaycastHit hit, LayerMask layerMask)
    {
        return Physics.Raycast(origin, Vector3.down, out hit, Mathf.Infinity, layerMask);
    }


