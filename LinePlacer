    // Method to place objects in a circle perimeter
    private void PlaceObjectsInCircle()
    {
        if (_currentActiveLinePlacementPrefab == null)
        {
            Debug.LogWarning("No line prefab to place circle objects.");
            return;
        }

        List<GameObject> placedObjects = new List<GameObject>();
        Vector3 lineBoundsExtents = _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents;
        float objectLength = lineBoundsExtents.z * 2;
        float objectWidth = lineBoundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        float circumference = 2 * Mathf.PI * _circleRadius;
        int numberOfObjects = Mathf.FloorToInt(circumference / effectiveObjectSize);

        if (numberOfObjects <= 0)
        {
            Debug.LogWarning("Circle too small to place objects.");
            return;
        }

        float angleStep = 360f / numberOfObjects;
        for (int i = 0; i < numberOfObjects; i++)
        {
            float angle = i * angleStep;
            Vector3 pointOnCircle = _circleCenter + new Vector3(Mathf.Cos(Mathf.Deg2Rad * angle), 0, Mathf.Sin(Mathf.Deg2Rad * angle)) * _circleRadius;

            RaycastHit hit;
            if (RaycastToTerrain(pointOnCircle + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
            {
                pointOnCircle.y = hit.point.y;
            }

            Vector3 direction = (pointOnCircle - _circleCenter).normalized; // Direction from center to object
            Quaternion objectRotation = Quaternion.LookRotation(direction);
            if (objectsRotatedRightOfLine)
            {
                objectRotation *= Quaternion.Euler(0, 90, 0); // Rotate 90 degrees relative to the radial direction
                Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                pointOnCircle += perpendicularOffset;
            }

            if (IsValidPlacement(pointOnCircle, lineBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid))
            {
                GameObject placed = Instantiate(_currentActiveLinePlacementPrefab, pointOnCircle, objectRotation, _currentPlacementParent.transform);
                placedObjects.Add(placed);
                if (_currentSelectedEntry.occupyGrid) MarkGridCellsOccupied(pointOnCircle, lineBoundsExtents);
            }
        }

        if (_currentSelectedEntry.combineLineMeshes && placedObjects.Count > 0)
        {
            CombineMeshes(placedObjects, "CombinedCircleLineMesh", _currentPlacementParent);
        }
    }

