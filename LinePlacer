    // Generic helper to place objects along a given path
    private void PlaceObjectsAlongPath(List<Vector3> pathPoints, GameObject prefabToPlace, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid, bool rotatedRightOfLine, List<GameObject> placedList)
    {
        if (pathPoints.Count < 2 || prefabToPlace == null) return;

        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2;
        float effectiveObjectSize = objectLength + spacing;
        float currentDistance = 0f;

        for (int i = 0; i < pathPoints.Count - 1; i++)
        {
            Vector3 startPoint = pathPoints[i];
            Vector3 endPoint = pathPoints[i + 1];
            float segmentLength = Vector3.Distance(startPoint, endPoint);
            Vector3 segmentDirection = (endPoint - startPoint).normalized;

            // Adjust start point if carrying over distance from previous segment
            Vector3 currentSegmentStart = startPoint + segmentDirection * currentDistance;
            float remainingSegmentLength = segmentLength - currentDistance;
            currentDistance = 0f; // Reset for this loop iteration

            while (remainingSegmentLength >= effectiveObjectSize)
            {
                Vector3 placementPosition = currentSegmentStart;

                RaycastHit hit;
                if (RaycastToTerrain(placementPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    placementPosition.y = hit.point.y;
                }

                Quaternion objectRotation = Quaternion.LookRotation(segmentDirection);
                if (rotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0);
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    placementPosition += perpendicularOffset;
                }

                if (IsValidPlacement(placementPosition, boundsExtents, canOverlap, occupyGrid))
                {
                    GameObject placed = Instantiate(prefabToPlace, placementPosition, objectRotation, _currentPlacementParent.transform);
                    placedList.Add(placed);
                    if (occupyGrid) MarkGridCellsOccupied(placementPosition, boundsExtents);
                }

                currentSegmentStart += segmentDirection * effectiveObjectSize;
                remainingSegmentLength -= effectiveObjectSize;
            }
            currentDistance = remainingSegmentLength; // Carry over remaining distance to next segment
        }
    }

    // Method to combine meshes of multiple GameObjects into a single mesh
    private void CombineMeshes(List<GameObject> objectsToCombine, string combinedMeshName, GameObject parentObject)
    {
        if (objectsToCombine == null || objectsToCombine.Count == 0 || parentObject == null)
        {
            Debug.LogWarning("No objects to combine or parent object is null.");
            return;
        }

        // Ensure all objects are children of the parentObject for proper local space transformation
        // (This should already be handled by the instantiation into _currentPlacementParent)
        foreach (GameObject obj in objectsToCombine)
        {
            if (obj.transform.parent != parentObject.transform)
            {
                obj.transform.SetParent(parentObject.transform, worldPositionStays: true);
            }
        }

        // Create a new GameObject to hold the combined mesh
        GameObject combinedMeshGO = new GameObject(combinedMeshName);
        combinedMeshGO.transform.SetParent(parentObject.transform, worldPositionStays: false);
        combinedMeshGO.AddComponent<MeshFilter>();
        combinedMeshGO.AddComponent<MeshRenderer>();

        // Collect all mesh filters and materials
        List<MeshFilter> meshFilters = new List<MeshFilter>();
        List<Material> materials = new List<Material>();

        foreach (GameObject obj in objectsToCombine)
        {
            MeshFilter[] childMeshFilters = obj.GetComponentsInChildren<MeshFilter>();
            MeshRenderer[] childMeshRenderers = obj.GetComponentsInChildren<MeshRenderer>();

            for (int i = 0; i < childMeshFilters.Length; i++)
            {
                meshFilters.Add(childMeshFilters[i]);
                if (i < childMeshRenderers.Length)
                {
                    materials.AddRange(childMeshRenderers[i].sharedMaterials);
                }
            }
        }

        // If no mesh filters found, can't combine
        if (meshFilters.Count == 0)
        {
            Debug.LogWarning("No mesh filters found on objects to combine.");
            Destroy(combinedMeshGO);
            return;
        }

        // Combine based on materials (if multiple materials, create submeshes)
        // Group submeshes by material
        Dictionary<Material, List<CombineInstance>> combinesByMaterial = new Dictionary<Material, List<CombineInstance>>();

        for (int i = 0; i < meshFilters.Count; i++)
        {
            MeshFilter mf = meshFilters[i];
            MeshRenderer mr = mf.GetComponent<MeshRenderer>();
            if (mr == null || mf.sharedMesh == null) continue;

            for (int sub = 0; sub < mf.sharedMesh.subMeshCount; sub++)
            {
                Material mat = mr.sharedMaterials[sub]; // Use sharedMaterials
                if (!combinesByMaterial.ContainsKey(mat))
                {
                    combinesByMaterial[mat] = new List<CombineInstance>();
                }

                CombineInstance ci = new CombineInstance();
                ci.mesh = mf.sharedMesh;
                ci.subMeshIndex = sub;
                // Transform to the local space of the combinedMeshGO (which is a child of parentObject)
                ci.transform = combinedMeshGO.transform.worldToLocalMatrix * mf.transform.localToWorldMatrix;
                combinesByMaterial[mat].Add(ci);
            }
        }

        Mesh newMesh = new Mesh();
        newMesh.name = combinedMeshName;
        newMesh.indexFormat = UnityEngine.Rendering.IndexFormat.UInt32; // For large meshes

        if (combinesByMaterial.Count == 0)
        {
            Debug.LogWarning("No valid meshes or materials to combine.");
            Destroy(combinedMeshGO);
            return;
        }

        // Set materials and combine meshes
        combinedMeshGO.GetComponent<MeshRenderer>().sharedMaterials = combinesByMaterial.Keys.ToArray();
        List<CombineInstance> allCombines = new List<CombineInstance>();
        foreach (var entry in combinesByMaterial)
        {
            allCombines.AddRange(entry.Value);
        }

        newMesh.CombineMeshes(allCombines.ToArray(), mergeSubMeshes: true, useMatrices: true);


        combinedMeshGO.GetComponent<MeshFilter>().sharedMesh = newMesh;

        // Optionally, add a mesh collider to the combined object
        MeshCollider meshCollider = combinedMeshGO.GetComponent<MeshCollider>();
        if (meshCollider == null)
        {
            meshCollider = combinedMeshGO.AddComponent<MeshCollider>();
        }
        meshCollider.sharedMesh = newMesh;
        meshCollider.convex = true; // Often required for non-static combined meshes, or if physics interactions are needed. Adjust as necessary.

        // Disable and destroy original objects
        foreach (GameObject obj in objectsToCombine)
        {
            if (obj != null)
            {
                // Disable renderers and colliders immediately if you want them gone instantly
                MeshRenderer objRenderer = obj.GetComponent<MeshRenderer>();
                if (objRenderer != null) objRenderer.enabled = false;
                Collider objCollider = obj.GetComponent<Collider>();
                if (objCollider != null) objCollider.enabled = false;

                // Destroy the original object
                Destroy(obj);
            }
        }

        Debug.Log($"Combined {objectsToCombine.Count} objects into {combinedMeshName} under {parentObject.name}.");
    }

    // New: Helper to set all placement UI buttons interactable state
    private void SetAllPlacementButtonsInteractable(bool interactable)
    {
        foreach (var entry in placeableObjectEntries)
        {
            if (entry.lineButton != null) entry.lineButton.interactable = interactable;
            if (entry.boxAndFillButton != null) entry.boxAndFillButton.interactable = interactable;
            if (entry.lineLoopButton != null) entry.lineLoopButton.interactable = interactable;
            if (entry.boxLineButton != null) entry.boxLineButton.interactable = interactable;
            if (entry.boxFillButton != null) entry.boxFillButton.interactable = interactable;
            if (entry.lineLoopFillButton != null) entry.lineLoopFillButton.interactable = interactable;
            if (entry.lineCircleButton != null) entry.lineCircleButton.interactable = interactable;
            if (entry.lineCircleFillButton != null) entry.lineCircleFillButton.interactable = interactable;
        }
    }
