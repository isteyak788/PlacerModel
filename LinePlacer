    void Awake()
    {
        LineRenderer internalLineRenderer = GetComponent<LineRenderer>();
        if (internalLineRenderer == null)
        {
            internalLineRenderer = gameObject.AddComponent<LineRenderer>();
            internalLineRenderer.startWidth = 0.1f;
            internalLineRenderer.endWidth = 0.1f;
            internalLineRenderer.material = new Material(Shader.Find("Sprites/Default"));
            internalLineRenderer.startColor = Color.clear;
            internalLineRenderer.endColor = Color.clear;
        }
        internalLineRenderer.enabled = false;

        if (boxPreviewLineRenderer != null)
        {
            boxPreviewLineRenderer.positionCount = 0;
            boxPreviewLineRenderer.enabled = false;
        }
        else
        {
            Debug.LogWarning("Box Preview Line Renderer is not assigned! Box draw preview will not work.");
        }
    }

    void OnEnable()
    {
        foreach (var entry in placeableObjectEntries)
        {
            // Helper function to check if a BuildingInfo and its prefabs are valid
            bool IsBuildingInfoValid(BuildingInfo info)
            {
                return info != null && (info.buildingPrefab != null || info.buildingGhostPrefab != null);
            }

            bool hasValidLinePrefab = IsBuildingInfoValid(entry.lineBuildingInfo);
            bool hasValidFillPrefab = IsBuildingInfoValid(entry.fillBuildingInfo);

            if (entry.lineButton != null)
            {
                entry.lineButton.onClick.RemoveAllListeners();
                entry.lineButton.onClick.AddListener(() => ActivateLineMode(entry));
                entry.lineButton.interactable = hasValidLinePrefab;
            }
            if (entry.boxAndFillButton != null)
            {
                entry.boxAndFillButton.onClick.RemoveAllListeners();
                entry.boxAndFillButton.onClick.AddListener(() => ActivateBoxMode(entry));
                // Box mode can work with line OR fill
                entry.boxAndFillButton.interactable = hasValidLinePrefab || hasValidFillPrefab;
            }
            if (entry.lineLoopButton != null)
            {
                entry.lineLoopButton.onClick.RemoveAllListeners();
                entry.lineLoopButton.onClick.AddListener(() => ActivateLineLoopMode(entry));
                entry.lineLoopButton.interactable = hasValidLinePrefab;
            }
            if (entry.boxLineButton != null)
            {
                entry.boxLineButton.onClick.RemoveAllListeners();
                entry.boxLineButton.onClick.AddListener(() => ActivateBoxLineMode(entry));
                entry.boxLineButton.interactable = hasValidLinePrefab;
            }
            if (entry.boxFillButton != null)
            {
                entry.boxFillButton.onClick.RemoveAllListeners();
                entry.boxFillButton.onClick.AddListener(() => ActivateBoxFillMode(entry));
                entry.boxFillButton.interactable = hasValidFillPrefab;
            }
            if (entry.lineLoopFillButton != null)
            {
                entry.lineLoopFillButton.onClick.RemoveAllListeners();
                entry.lineLoopFillButton.onClick.AddListener(() => ActivateLineLoopFillMode(entry));
                // Line Loop Fill mode can work with line OR fill
                entry.lineLoopFillButton.interactable = hasValidLinePrefab || hasValidFillPrefab;
            }
            if (entry.lineCircleButton != null)
            {
                entry.lineCircleButton.onClick.RemoveAllListeners();
                entry.lineCircleButton.onClick.AddListener(() => ActivateLineCircleMode(entry));
                entry.lineCircleButton.interactable = hasValidLinePrefab;
            }
            if (entry.lineCircleFillButton != null)
            {
                entry.lineCircleFillButton.onClick.RemoveAllListeners();
                entry.lineCircleFillButton.onClick.AddListener(() => ActivateLineCircleFillMode(entry));
                // Line Circle Fill mode can work with line OR fill
                entry.lineCircleFillButton.interactable = hasValidLinePrefab || hasValidFillPrefab;
            }
        }

        ExitPlacementMode();

        // Activate default mode if set
        if (defaultPlacementMode != ActivePlacementMode.None && defaultEntryIndex >= 0 && defaultEntryIndex < placeableObjectEntries.Length)
        {
            PlaceableObjectEntry defaultEntry = placeableObjectEntries[defaultEntryIndex];
            // Re-check validity based on the specific mode's requirements
            bool canActivateDefault = false;
            if (defaultPlacementMode == ActivePlacementMode.Line || defaultPlacementMode == ActivePlacementMode.LineLoop ||
                defaultPlacementMode == ActivePlacementMode.BoxLine || defaultPlacementMode == ActivePlacementMode.LineCircle)
            {
                canActivateDefault = defaultEntry.lineBuildingInfo != null && (defaultEntry.lineBuildingInfo.buildingPrefab != null || defaultEntry.lineBuildingInfo.buildingGhostPrefab != null);
            }
            else if (defaultPlacementMode == ActivePlacementMode.BoxFill)
            {
                canActivateDefault = defaultEntry.fillBuildingInfo != null && (defaultEntry.fillBuildingInfo.buildingPrefab != null || defaultEntry.fillBuildingInfo.buildingGhostPrefab != null);
            }
            else if (defaultPlacementMode == ActivePlacementMode.Box || defaultPlacementMode == ActivePlacementMode.LineLoopFill || defaultPlacementMode == ActivePlacementMode.LineCircleFill)
            {
                // For combined modes, can activate if AT LEAST ONE of line or fill prefabs is available.
                canActivateDefault = (defaultEntry.lineBuildingInfo != null && (defaultEntry.lineBuildingInfo.buildingPrefab != null || defaultEntry.lineBuildingInfo.buildingGhostPrefab != null)) ||
                                     (defaultEntry.fillBuildingInfo != null && (defaultEntry.fillBuildingInfo.buildingPrefab != null || defaultEntry.fillBuildingInfo.buildingGhostPrefab != null));
            }


            if (canActivateDefault)
            {
                if (defaultPlacementMode == ActivePlacementMode.Line) ActivateLineMode(defaultEntry);
                else if (defaultPlacementMode == ActivePlacementMode.Box) ActivateBoxMode(defaultEntry);
                else if (defaultPlacementMode == ActivePlacementMode.LineLoop) ActivateLineLoopMode(defaultEntry);
                else if (defaultPlacementMode == ActivePlacementMode.BoxLine) ActivateBoxLineMode(defaultEntry);
                else if (defaultPlacementMode == ActivePlacementMode.BoxFill) ActivateBoxFillMode(defaultEntry);
                else if (defaultPlacementMode == ActivePlacementMode.LineLoopFill) ActivateLineLoopFillMode(defaultEntry);
                else if (defaultPlacementMode == ActivePlacementMode.LineCircle) ActivateLineCircleMode(defaultEntry);
                else if (defaultPlacementMode == ActivePlacementMode.LineCircleFill) ActivateLineCircleFillMode(defaultEntry);
            }
            else
            {
                Debug.LogWarning($"Default placement mode {defaultPlacementMode} for entry {defaultEntryIndex} could not be activated due to missing required BuildingInfo or prefabs.");
            }
        }
    }

    void OnDisable()
    {
        foreach (var entry in placeableObjectEntries)
        {
            if (entry.lineButton != null) entry.lineButton.onClick.RemoveAllListeners();
            if (entry.boxAndFillButton != null) entry.boxAndFillButton.onClick.RemoveAllListeners();
            if (entry.lineLoopButton != null) entry.lineLoopButton.onClick.RemoveAllListeners();
            if (entry.boxLineButton != null) entry.boxLineButton.onClick.RemoveAllListeners();
            if (entry.boxFillButton != null) entry.boxFillButton.onClick.RemoveAllListeners();
            if (entry.lineLoopFillButton != null) entry.lineLoopFillButton.onClick.RemoveAllListeners();
            if (entry.lineCircleButton != null) entry.lineCircleButton.onClick.RemoveAllListeners();
            if (entry.lineCircleFillButton != null) entry.lineCircleFillButton.onClick.RemoveAllListeners();
        }

        // Only exit placement mode, do NOT destroy _currentPlacementParent here directly
        // if it might contain permanent objects. Let individual placement complete functions handle it.
        ExitPlacementMode(forceDestroyParent: false);
    }

    // Common setup for activating any placement mode
    private void StartPlacementSetup(PlaceableObjectEntry entry, ActivePlacementMode mode)
    {
        // Helper function to check if a BuildingInfo and its prefabs are valid
        bool IsBuildingInfoValid(BuildingInfo info)
        {
            return info != null && (info.buildingPrefab != null || info.buildingGhostPrefab != null);
        }

        bool hasValidLinePrefab = IsBuildingInfoValid(entry.lineBuildingInfo);
        bool hasValidFillPrefab = IsBuildingInfoValid(entry.fillBuildingInfo);

        // Basic validity check for the specific mode - changed for combined modes
        bool isValidForMode = false;
        switch (mode)
        {
            case ActivePlacementMode.Line:
            case ActivePlacementMode.LineLoop:
            case ActivePlacementMode.BoxLine:
            case ActivePlacementMode.LineCircle:
                isValidForMode = hasValidLinePrefab;
                _currentActiveLinePlacementPrefab = entry.lineBuildingInfo?.buildingPrefab;
                _currentActiveLineGhostPrefab = entry.lineBuildingInfo?.buildingGhostPrefab;
                _currentActiveFillPlacementPrefab = null; // Ensure fill prefabs are cleared if not used
                _currentActiveFillGhostPrefab = null;
                break;
            case ActivePlacementMode.BoxFill:
                isValidForMode = hasValidFillPrefab;
                _currentActiveFillPlacementPrefab = entry.fillBuildingInfo?.buildingPrefab;
                _currentActiveFillGhostPrefab = entry.fillBuildingInfo?.buildingGhostPrefab;
                _currentActiveLinePlacementPrefab = null; // Ensure line prefabs are cleared if not used
                _currentActiveLineGhostPrefab = null;
                break;
            case ActivePlacementMode.Box:
            case ActivePlacementMode.LineLoopFill:
            case ActivePlacementMode.LineCircleFill:
                // For combined modes, valid if at least one of line or fill prefabs is available
                isValidForMode = hasValidLinePrefab || hasValidFillPrefab;
                _currentActiveLinePlacementPrefab = hasValidLinePrefab ? entry.lineBuildingInfo?.buildingPrefab : null;
                _currentActiveLineGhostPrefab = hasValidLinePrefab ? entry.lineBuildingInfo?.buildingGhostPrefab : null;
                _currentActiveFillPlacementPrefab = hasValidFillPrefab ? entry.fillBuildingInfo?.buildingPrefab : null;
                _currentActiveFillGhostPrefab = hasValidFillPrefab ? entry.fillBuildingInfo?.buildingGhostPrefab : null;
                break;
        }


        if (!isValidForMode)
        {
            Debug.LogError($"Cannot start placement for {entry.lineBuildingInfo?.buildingName ?? entry.fillBuildingInfo?.buildingName ?? "null entry"}: Required BuildingInfo or its prefabs are missing for mode {mode}!");
            return;
        }

        // Handle continuous mode deactivation if the same button is pressed
        if (_currentActiveMode == mode && _currentSelectedEntry == entry && entry.isContinuous)
        {
            Debug.Log($"Deactivating continuous {mode} placement for {entry.lineBuildingInfo?.buildingName ?? entry.fillBuildingInfo?.buildingName ?? "unknown"}.");
            ExitPlacementMode();
            return;
        }

        // Exit any currently active mode before starting a new one
        // If _currentPlacementParent exists and has children, it means a previous
        // placement completed successfully (non-continuous), so we should not destroy it.
        // Instead, we just clear current mode state and create a new parent below.
        if (_currentActiveMode != ActivePlacementMode.None)
        {
            // If the previous mode was continuous and is now being switched off, clear previews.
            // If it was non-continuous, it should have already been handled at placement completion.
            DisableVisualAids();
        }

        // Always create a new parent when a *new* placement is initiated
        // (unless it's continuous mode and the same button was re-pressed to deactivate it)
        if (_currentPlacementParent == null || (_currentSelectedEntry != null && !_currentSelectedEntry.isContinuous))
        {
            _currentPlacementParent = InstantiatePlacementParent(Vector3.zero);
        }


        _currentSelectedEntry = entry;
        _currentActiveMode = mode;

        currentState = LinePlacementState.Idle;
        linePoints.Clear();
        DisableVisualAids(); // Clear any existing previews from previous mode
        _isDrawingCircle = false;
        _circleRadius = 0;


        SetAllPlacementButtonsInteractable(false); // Disable all buttons once a mode is active

        string debugMsg = $"Started {_currentActiveMode} placement for {entry.lineBuildingInfo?.buildingName ?? entry.fillBuildingInfo?.buildingName ?? "unknown"}.";
        if (_currentActiveMode == ActivePlacementMode.Line || _currentActiveMode == ActivePlacementMode.LineLoop || _currentActiveMode == ActivePlacementMode.LineLoopFill)
        {
            debugMsg += " Click to add points. Press Enter to finalize. Right Click to cancel.";
            if (_currentActiveMode == ActivePlacementMode.LineLoop)
            {
                debugMsg += " (Will form a loop)";
            }
            if (_currentActiveMode == ActivePlacementMode.LineLoopFill)
            {
                // Adjusted debug message to reflect optional line/fill
                debugMsg += " (Will form a loop and " + (hasValidLinePrefab ? "place perimeter " : "") + (hasValidLinePrefab && hasValidFillPrefab ? "and " : "") + (hasValidFillPrefab ? "fill the interior" : "") + ")";
            }
        }
        else if (_currentActiveMode == ActivePlacementMode.Box || _currentActiveMode == ActivePlacementMode.BoxLine || _currentActiveMode == ActivePlacementMode.BoxFill)
        {
            debugMsg += " Click and Drag to define box, release to place. Right Click to cancel.";
            if (_currentActiveMode == ActivePlacementMode.Box)
            {
                debugMsg += " (Will place " + (hasValidLinePrefab ? "perimeter " : "") + (hasValidLinePrefab && hasValidFillPrefab ? "and " : "") + (hasValidFillPrefab ? "fill" : "") + ")";
            }
        }
        else if (_currentActiveMode == ActivePlacementMode.LineCircle || _currentActiveMode == ActivePlacementMode.LineCircleFill)
        {
            debugMsg += " Click to set center, drag to set radius, click again to finalize. Right Click to cancel.";
            if (_currentActiveMode == ActivePlacementMode.LineCircleFill)
            {
                debugMsg += " (Will place " + (hasValidLinePrefab ? "perimeter " : "") + (hasValidLinePrefab && hasValidFillPrefab ? "and " : "") + (hasValidFillPrefab ? "fill" : "") + ")";
            }
        }

        if (entry.isContinuous) debugMsg += " (Continuous Mode: click button again to deactivate.)";
        Debug.Log(debugMsg);
    }

    public void ActivateLineMode(PlaceableObjectEntry entry)
    {
        if (entry.lineBuildingInfo == null || (entry.lineBuildingInfo.buildingPrefab == null && entry.lineBuildingInfo.buildingGhostPrefab == null))
        {
            Debug.LogWarning("Line object prefab is null for this entry's Line BuildingInfo.");
            return;
        }
        StartPlacementSetup(entry, ActivePlacementMode.Line);
    }

    public void ActivateBoxMode(PlaceableObjectEntry entry)
    {
        // Box mode now requires at least one of line or fill prefabs
        if ((entry.lineBuildingInfo == null || (entry.lineBuildingInfo.buildingPrefab == null && entry.lineBuildingInfo.buildingGhostPrefab == null)) &&
            (entry.fillBuildingInfo == null || (entry.fillBuildingInfo.buildingPrefab == null && entry.fillBuildingInfo.buildingGhostPrefab == null)))
        {
            Debug.LogWarning("Box mode requires at least one of Line or Fill prefabs to be assigned.");
            return;
        }
        StartPlacementSetup(entry, ActivePlacementMode.Box);
    }

