    private void PlaceAllObjectsFromLine()
    {
        if (_currentSelectedEntry == null || _currentActiveLinePlacementPrefab == null || linePoints.Count < 2)
        {
            Debug.LogWarning("Cannot place line objects: missing prefab or not enough points.");
            ExitPlacementMode();
            return;
        }

        Vector3 lineBoundsExtents = _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents;
        float objectLength = lineBoundsExtents.z * 2;
        float objectWidth = lineBoundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        List<Vector3> interpolatedPoints = new List<Vector3>();

        for (int i = 0; i < linePoints.Count - 1; i++)
        {
            Vector3 p0 = i == 0 ? linePoints[0] : linePoints[i - 1];
            Vector3 p1 = linePoints[i];
            Vector3 p2 = linePoints[i + 1];
            Vector3 p3 = (i + 2 >= linePoints.Count) ? linePoints[linePoints.Count - 1] : linePoints[i + 2];

            for (int j = 0; j <= curveResolution; j++)
            {
                float t = (float)j / curveResolution;
                Vector3 interpolatedPoint = GetCatmullRomPosition(t, p0, p1, p2, p3);
                RaycastHit hit;
                if (RaycastToTerrain(interpolatedPoint + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    interpolatedPoint.y = hit.point.y;
                }
                else
                {
                    // Fallback to average Y of segment points if raycast fails
                    interpolatedPoint.y = (p1.y + p2.y) / 2f;
                }
                interpolatedPoints.Add(interpolatedPoint);
            }
        }

        float currentPathDistance = 0f;
        float nextObjectDistanceTarget = effectiveObjectSize / 2f;

        List<GameObject> placedLineObjects = new List<GameObject>();

        for (int i = 0; i < interpolatedPoints.Count - 1; i++)
        {
            Vector3 startPoint = interpolatedPoints[i];
            Vector3 endPoint = interpolatedPoints[i + 1];
            float segmentLength = Vector3.Distance(startPoint, endPoint);
            Vector3 segmentDirection = (endPoint - startPoint).normalized;

            while (currentPathDistance + segmentLength >= nextObjectDistanceTarget)
            {
                float distanceIntoSegment = nextObjectDistanceTarget - currentPathDistance;
                if (segmentLength < 0.001f && distanceIntoSegment > 0) break;

                Vector3 objectPosition = Vector3.Lerp(startPoint, endPoint, distanceIntoSegment / segmentLength);
                RaycastHit hit;
                if (RaycastToTerrain(objectPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    objectPosition.y = hit.point.y;
                }
                else
                {
                    nextObjectDistanceTarget += effectiveObjectSize;
                    continue;
                }

                Quaternion objectRotation = Quaternion.LookRotation(segmentDirection);
                if (objectsRotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0);
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    objectPosition += perpendicularOffset;
                }

                if (_currentActiveLinePlacementPrefab != null) // Only place if line prefab exists
                {
                    if (_currentPlacementParent == null) _currentPlacementParent = InstantiatePlacementParent(objectPosition);
                    if (IsValidPlacement(objectPosition, lineBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid))
                    {
                        GameObject placedObject = Instantiate(_currentActiveLinePlacementPrefab, objectPosition, objectRotation, _currentPlacementParent.transform);
                        placedLineObjects.Add(placedObject);
                        if (_currentSelectedEntry.occupyGrid) _occupiedGridCells.Add(WorldToGrid(objectPosition));
                    }
                }
                nextObjectDistanceTarget += effectiveObjectSize;
            }
            currentPathDistance += segmentLength;
        }

        if (_currentSelectedEntry.combineLineMeshes && placedLineObjects.Count > 1)
        {
            CombineMeshes(placedLineObjects, "CombinedLineMesh");
        }

        Debug.Log($"Placed {placedLineObjects.Count} line objects.");

        // Reset line points and disable line renderer immediately after placement
        linePoints.Clear();
        GetComponent<LineRenderer>().enabled = false;
        currentState = LinePlacementState.Idle; // Return to idle state after placement

        if (!_currentSelectedEntry.isContinuous) ExitPlacementMode();
    }

