    // NEW Helper Methods for Generating Previews & Placement (Refactored from previous logic)
    // These methods centralize the logic for drawing different types of objects for previews and final placement.
    // ------------------------------------------------------------------------------------------------------

    // New: Generates previews for objects along a line path
    // Used by UpdateLineObjectPreviews
    private void GenerateObjectsAlongPathPreviews(List<Vector3> pathPoints, GameObject ghostPrefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid, bool rotatedRightOfLine, int curveResolution)
    {
        if (pathPoints.Count < 2 || ghostPrefab == null) return;

        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2;
        float effectiveObjectSize = objectLength + spacing;
        float currentDistance = 0f;
        Vector3 previousPoint = pathPoints[0];

        // Ensure the first object is placed
        Vector3 initialDirection = (pathPoints[1] - pathPoints[0]).normalized;
        Quaternion initialRotation = Quaternion.LookRotation(initialDirection);
        Vector3 initialPos = pathPoints[0];

        if (rotatedRightOfLine)
        {
            initialRotation *= Quaternion.Euler(0, 90, 0);
            Vector3 perpendicularOffset = initialRotation * Vector3.forward * (objectWidth / 2f);
            initialPos += perpendicularOffset;
        }

        // Always attempt to place the first object, even if distance is 0, if there are multiple points
        if (pathPoints.Count > 1) {
             bool isValidFirst = IsValidPlacement(initialPos, boundsExtents, canOverlap, occupyGrid);
             GameObject previewFirst = Instantiate(ghostPrefab, initialPos, initialRotation);
             currentObjectPreviews.Add(previewFirst);
             SetPreviewMaterial(previewFirst, isValidFirst ? validPlacementMaterial : invalidPlacementMaterial);
        }


        for (int i = 1; i < pathPoints.Count; i++)
        {
            Vector3 currentPoint = pathPoints[i];
            float segmentLength = Vector3.Distance(previousPoint, currentPoint);
            currentDistance += segmentLength;

            while (currentDistance >= effectiveObjectSize)
            {
                currentDistance -= effectiveObjectSize;

                // Calculate exact position along the segment
                float overshoot = effectiveObjectSize - segmentLength + currentDistance; // how much past current point
                Vector3 position = Vector3.Lerp(currentPoint, previousPoint, overshoot / segmentLength);

                RaycastHit hit;
                if (RaycastToTerrain(position + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    position.y = hit.point.y;
                }
                else
                {
                    continue; // Skip if no terrain found
                }

                Vector3 direction = (currentPoint - previousPoint).normalized;
                Quaternion objectRotation = Quaternion.LookRotation(direction);

                if (rotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0); // Rotate 90 degrees relative to the line direction
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    position += perpendicularOffset;
                }

                bool isValid = IsValidPlacement(position, boundsExtents, canOverlap, occupyGrid);
                GameObject preview = Instantiate(ghostPrefab, position, objectRotation);
                currentObjectPreviews.Add(preview);
                SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
            }
            previousPoint = currentPoint;
        }
    }


    // New: Generates previews for objects filling a box area
    // Used by UpdateBoxObjectPreviews
    private void GenerateBoxFillPreviews(Vector3 minCorner, Vector3 maxCorner, GameObject ghostPrefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        if (ghostPrefab == null) return;

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;
        float stepX = objectWidth + spacing;
        float stepZ = objectLength + spacing;

        // Ensure a minimum size to avoid infinite loops with tiny objects/spacing
        if (stepX <= 0 || stepZ <= 0) return;

        for (float x = minCorner.x + boundsExtents.x; x < maxCorner.x; x += stepX)
        {
            for (float z = minCorner.z + boundsExtents.z; z < maxCorner.z; z += stepZ)
            {
                Vector3 position = new Vector3(x, minCorner.y, z);

                RaycastHit hit;
                if (RaycastToTerrain(position + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    position.y = hit.point.y;
                }
                else
                {
                    continue; // Skip if no terrain found
                }

                bool isValid = IsValidPlacement(position, boundsExtents, canOverlap, occupyGrid);
                GameObject preview = Instantiate(ghostPrefab, position, Quaternion.identity);
                currentObjectPreviews.Add(preview);
                SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
            }
        }
    }

    // New: Generates previews for objects along the perimeter of a box
    // Used by UpdateBoxObjectPreviews
    private void GenerateBoxLinePreviews(Vector3 minCorner, Vector3 maxCorner, GameObject ghostPrefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        if (ghostPrefab == null) return;

        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2; // For perpendicular offset
        float effectiveObjectSize = objectLength + spacing;

        // Define corners for iterating along the perimeter
        Vector3 p1 = new Vector3(minCorner.x, minCorner.y, minCorner.z);
        Vector3 p2 = new Vector3(maxCorner.x, minCorner.y, minCorner.z);
        Vector3 p3 = new Vector3(maxCorner.x, minCorner.y, maxCorner.z);
        Vector3 p4 = new Vector3(minCorner.x, minCorner.y, maxCorner.z);

        List<Vector3> perimeterPoints = new List<Vector3> { p1, p2, p3, p4, p1 }; // Closing the loop

        // Use the generic path preview generator
        GenerateObjectsAlongPathPreviews(perimeterPoints, ghostPrefab, boundsExtents, spacing, canOverlap, occupyGrid, objectsRotatedRightOfLine, curveResolution);
    }


    // New: Generates previews for objects filling a circle area
    // Used by UpdateCircleObjectPreviews
    private void GenerateCircleFillPreviews(Vector3 center, float radius, GameObject ghostPrefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        if (ghostPrefab == null || radius <= 0) return;

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;
        float step = Mathf.Min(objectWidth, objectLength) + spacing; // Use smaller dimension for stepping

        if (step <= 0) return;

        // Iterate in a square grid within the circle's bounding box
        for (float x = center.x - radius; x <= center.x + radius; x += step)
        {
            for (float z = center.z - radius; z <= center.z + radius; z += step)
            {
                Vector3 position = new Vector3(x, center.y, z);

                // Check if the current position is within the circle
                if (Vector3.Distance(center, new Vector3(position.x, center.y, position.z)) <= radius)
                {
                    RaycastHit hit;
                    if (RaycastToTerrain(position + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        position.y = hit.point.y;
                    }
                    else
                    {
                        continue; // Skip if no terrain found
                    }

                    bool isValid = IsValidPlacement(position, boundsExtents, canOverlap, occupyGrid);
                    GameObject preview = Instantiate(ghostPrefab, position, Quaternion.identity);
                    currentObjectPreviews.Add(preview);
                    SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
                }
            }
        }
    }

    // New: Generates previews for objects filling a line loop area
    // Used by UpdateLineObjectPreviews
    private void GenerateLineLoopFillPreviews(List<Vector3> currentLinePoints, Vector3 mouseWorldPosition, GameObject ghostPrefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        if (currentLinePoints.Count < 2 || ghostPrefab == null) return;

        List<Vector3> loopPoints = new List<Vector3>(currentLinePoints);
        loopPoints.Add(mouseWorldPosition); // Add mouse position to form the temporary loop

        if (loopPoints.Count < 3) return; // Need at least 3 points for a valid polygon

        // Calculate bounding box of the loop
        float minX = loopPoints.Min(p => p.x);
        float maxX = loopPoints.Max(p => p.x);
        float minZ = loopPoints.Min(p => p.z);
        float maxZ = loopPoints.Max(p => p.z);

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;
        float stepX = objectWidth + spacing;
        float stepZ = objectLength + spacing;

        if (stepX <= 0 || stepZ <= 0) return;

        for (float x = minX + boundsExtents.x; x < maxX; x += stepX)
        {
            for (float z = minZ + boundsExtents.z; z < maxZ; z += stepZ)
            {
                Vector3 position = new Vector3(x, loopPoints[0].y, z); // Use Y from first point, will be raycast corrected

                // Check if point is inside the polygon (2D check on XZ plane)
                if (IsPointInPolygon(new Vector2(position.x, position.z), loopPoints.Select(p => new Vector2(p.x, p.z)).ToList()))
                {
                    RaycastHit hit;
                    if (RaycastToTerrain(position + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        position.y = hit.point.y;
                    }
                    else
                    {
                        continue; // Skip if no terrain found
                    }

                    bool isValid = IsValidPlacement(position, boundsExtents, canOverlap, occupyGrid);
                    GameObject preview = Instantiate(ghostPrefab, position, Quaternion.identity);
                    currentObjectPreviews.Add(preview);
                    SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
                }
            }
        }
    }


    // Helper for Catmull-Rom spline interpolation
    private Vector3 GetCatmullRomPosition(float t, Vector3 p0, Vector3 p1, Vector3 p2, Vector3 p3)
    {
        // Catmull-Rom spline formula
        Vector3 a = 2f * p1;
        Vector3 b = p2 - p0;
        Vector3 c = 2f * p0 - 5f * p1 + 4f * p2 - p3;
        Vector3 d = -p0 + 3f * p1 - 3f * p2 + p3;

        return 0.5f * (a + (b * t) + (c * t * t) + (d * t * t * t));
    }


    // Helper for point-in-polygon test (ray casting algorithm)
    private bool IsPointInPolygon(Vector2 point, List<Vector2> polygon)
    {
        int polygonLength = polygon.Count;
        bool inside = false;

        for (int i = 0, j = polygonLength - 1; i < polygonLength; j = i++)
        {
            if (((polygon[i].y > point.y) != (polygon[j].y > point.y)) &&
                (point.x < (polygon[j].x - polygon[i].x) * (point.y - polygon[i].y) / (polygon[j].y - polygon[i].y) + polygon[i].x))
            {
                inside = !inside;
            }
        }
        return inside;
    }


