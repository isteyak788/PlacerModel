                    placedLineObjects.Add(placedObject);
                    OccupyGridCells(objectPosition, lineBoundsExtents);
                }
                nextObjectDistanceTarget += effectiveObjectSize;
            }
            currentPathDistance += segmentLength;
        }

        if (_currentSelectedEntry.combineLineMeshes && placedLineObjects.Count > 1)
        {
            CombineMeshes(placedLineObjects, _currentPlacementParent.transform, _currentActiveLinePlacementPrefab.GetComponent<MeshRenderer>()?.sharedMaterial);
        }

