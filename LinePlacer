    private void PlaceAllObjectsFromLineLoopFill()
    {
        if (linePoints.Count < 3)
        {
            Debug.LogWarning("Cannot form a line loop fill with less than 3 points.");
            ExitPlacementMode();
            return;
        }

        // Place line objects (perimeter)
        PlaceAllObjectsFromLineLoop(false); // Don't finalize yet

        // Place fill objects
        if (_currentActiveFillPlacementPrefab == null)
        {
            Debug.LogWarning("Line Loop Fill object prefab is null. Skipping fill placement.");
            FinalizePlacement();
            return;
        }

        List<GameObject> placedFillObjects = new List<GameObject>();
        Vector3 fillBoundsExtents = _currentSelectedEntry.fillBuildingInfo.buildingBoundsExtents;
        float cellWidth = fillBoundsExtents.x * 2 + fillObjectSpacing;
        float cellLength = fillBoundsExtents.z * 2 + fillObjectSpacing;

        // Find min/max bounds of the polygon
        float minX = float.MaxValue;
        float maxX = float.MinValue;
        float minZ = float.MaxValue;
        float maxZ = float.MinValue;

        foreach (Vector3 p in linePoints)
        {
            if (p.x < minX) minX = p.x;
            if (p.x > maxX) maxX = p.x;
            if (p.z < minZ) minZ = p.z;
            if (p.z > maxZ) maxZ = p.z;
        }

        // Iterate through a grid covering the polygon's bounding box
        for (float x = minX + fillBoundsExtents.x; x < maxX; x += cellWidth)
        {
            for (float z = minZ + fillBoundsExtents.z; z < maxZ; z += cellLength)
            {
                Vector3 objectPosition = new Vector3(x, linePoints[0].y, z);

                if (PointInPolygon(objectPosition, linePoints))
                {
                    RaycastHit hit;
                    if (RaycastToTerrain(objectPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        objectPosition.y = hit.point.y;
                    }
                    else
                    {
                        continue;
                    }

                    if (IsValidPlacement(objectPosition, fillBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid))
                    {
                        GameObject placedObject = Instantiate(_currentActiveFillPlacementPrefab, objectPosition, Quaternion.identity, _currentPlacementParent.transform);
                        placedFillObjects.Add(placedObject);
                        OccupyGridCells(objectPosition, fillBoundsExtents);
                    }
                }
            }
        }

        if (_currentSelectedEntry.combineFillMeshes && placedFillObjects.Count > 1)
        {
            // Pass the prefab's material directly here
            Material fillMaterial = _currentActiveFillPlacementPrefab.GetComponent<MeshRenderer>()?.sharedMaterial;
            CombineMeshes(placedFillObjects, _currentPlacementParent.transform, fillMaterial);
        }

        FinalizePlacement();
    }

    private void PlaceObjectsInCircle(bool finalize = true) // Added finalize parameter
