    private GameObject _currentActiveLineGhostPrefab;    // The ghost prefab from lineBuildingInfo
    private GameObject _currentActiveFillPlacementPrefab; // The main prefab from fillBuildingInfo
    private GameObject _currentActiveFillGhostPrefab;    // The ghost prefab from fillBuildingInfo

