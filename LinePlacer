    /// <summary>
    /// Combines the meshes of a list of GameObjects into a single new GameObject.
    /// The original GameObjects are destroyed after combining.
    /// </summary>
    /// <param name="objectsToCombine">List of GameObjects whose meshes will be combined.</param>
    /// <param name="parentTransform">The transform to parent the new combined object under.</param>
    /// <param name="material">The material to apply to the combined mesh. If null, will try to use source object's material from the first object in objectsToCombine.</param>
    private GameObject CombineMeshes(List<GameObject> objectsToCombine, Transform parentTransform, Material material)
    {
        if (objectsToCombine == null || objectsToCombine.Count == 0)
        {
            Debug.LogWarning("CombineMeshes: No objects to combine.");
            return null;
        }

        GameObject combinedObject = new GameObject("CombinedMesh");
        combinedObject.transform.SetParent(parentTransform);
        combinedObject.transform.localPosition = Vector3.zero;
        combinedObject.transform.localRotation = Quaternion.identity;
        combinedObject.transform.localScale = Vector3.one;

        MeshFilter meshFilter = combinedObject.AddComponent<MeshFilter>();
        MeshRenderer meshRenderer = combinedObject.AddComponent<MeshRenderer>();

        List<CombineInstance> combineInstances = new List<CombineInstance>();
        Material assignedMaterial = material; // Prioritize the material explicitly passed in

        foreach (GameObject obj in objectsToCombine)
        {
            MeshFilter[] meshFilters = obj.GetComponentsInChildren<MeshFilter>(true);
            foreach (MeshFilter filter in meshFilters)
            {
                if (filter.sharedMesh == null) continue; // Skip if no mesh

                CombineInstance combineInstance = new CombineInstance
                {
                    mesh = filter.sharedMesh,
                    transform = filter.transform.localToWorldMatrix // Use world matrix for accurate positioning
                };
                combineInstances.Add(combineInstance);

                // If no material was explicitly provided to this method, try to grab one from the first object we process
                if (assignedMaterial == null)
                {
                    MeshRenderer objRenderer = filter.GetComponent<MeshRenderer>();
                    if (objRenderer != null && objRenderer.sharedMaterial != null)
                    {
                        assignedMaterial = objRenderer.sharedMaterial;
                        Debug.Log("CombineMeshes: Used material from first object in list as no material was provided or found on main prefab.");
                    }
                }
            }
            Destroy(obj); // Destroy the original individual object
        }

        if (combineInstances.Count == 0)
        {
            Debug.LogWarning("CombineMeshes: No valid meshes found in objects to combine. Destroying empty combined object.");
            Destroy(combinedObject);
            return null;
        }

        meshFilter.mesh = new Mesh();
        meshFilter.mesh.indexFormat = UnityEngine.Rendering.IndexFormat.UInt32; // For larger meshes
        meshFilter.mesh.CombineMeshes(combineInstances.ToArray(), true, true); // Merge submeshes, use world space
        
        if (assignedMaterial == null)
        {
            Debug.LogError("CombineMeshes: No material found for the combined mesh. It will be invisible. Please ensure your prefab has a MeshRenderer with a material assigned.");
        }
        meshRenderer.sharedMaterial = assignedMaterial; // Assign the material

        // Recalculate normals and bounds after combining
        meshFilter.mesh.RecalculateNormals();
        meshFilter.mesh.RecalculateBounds();
        meshFilter.mesh.Optimize(); // Optimize the combined mesh

        Debug.Log($"Combined {objectsToCombine.Count} meshes into a single object: {combinedObject.name}");

        return combinedObject;
    }
}
