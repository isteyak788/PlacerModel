        else
        {
            currentState = LinePlacementState.Idle;
            _isDrawingCircle = false;
            _circleRadius = 0;
            ClearObjectPreviews();
        }
    }


    // New: Generic function to place objects along a path (used by lines, loops, box lines, etc.)
    private void PlaceObjectsAlongPath(List<Vector3> pathPoints, GameObject objectPrefab, Vector3 boundsExtents, float spacing,
                                       bool canOverlap, bool occupyGrid, bool rotatedRightOfLine, int curveResolution, List<GameObject> placedObjects)
    {
        if (pathPoints.Count < 2 || objectPrefab == null) return;

        List<Vector3> interpolatedPoints = new List<Vector3>();

        for (int i = 0; i < pathPoints.Count - 1; i++)
        {
            Vector3 p0 = i == 0 ? pathPoints[0] : pathPoints[i - 1]; // Use first point twice if at start
            Vector3 p1 = pathPoints[i];
            Vector3 p2 = pathPoints[i + 1];
            Vector3 p3 = (i + 2 >= pathPoints.Count) ? pathPoints[pathPoints.Count - 1] : pathPoints[i + 2]; // Use last point twice if at end

            for (int j = 0; j <= curveResolution; j++)
            {
                float t = (float)j / curveResolution;
                Vector3 interpolatedPoint = GetCatmullRomPosition(t, p0, p1, p2, p3);

                RaycastHit hit;
                if (RaycastToTerrain(interpolatedPoint + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    interpolatedPoint.y = hit.point.y;
                }
                interpolatedPoints.Add(interpolatedPoint);
            }
        }

        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2;
        float effectiveObjectSize = objectLength + spacing;
        float currentDistance = 0f;
        Vector3 previousPoint = interpolatedPoints[0];

        // Ensure the first object is placed
        Vector3 initialDirection = (interpolatedPoints[1] - interpolatedPoints[0]).normalized;
        Quaternion initialRotation = Quaternion.LookRotation(initialDirection);
        Vector3 initialPos = interpolatedPoints[0];

        if (rotatedRightOfLine)
        {
            initialRotation *= Quaternion.Euler(0, 90, 0);
            Vector3 perpendicularOffset = initialRotation * Vector3.forward * (objectWidth / 2f);
            initialPos += perpendicularOffset;
        }

        if (interpolatedPoints.Count > 1 && IsValidPlacement(initialPos, boundsExtents, canOverlap, occupyGrid))
        {
            GameObject obj = Instantiate(objectPrefab, initialPos, initialRotation, _currentPlacementParent.transform);
            if (occupyGrid)
            {
                MarkGridCellsOccupied(initialPos, boundsExtents);
            }
            placedObjects.Add(obj);
        }

        for (int i = 1; i < interpolatedPoints.Count; i++)
        {
            Vector3 currentPoint = interpolatedPoints[i];
            float segmentLength = Vector3.Distance(previousPoint, currentPoint);
            currentDistance += segmentLength;

            while (currentDistance >= effectiveObjectSize)
            {
                currentDistance -= effectiveObjectSize;

                // Calculate exact position along the segment
                float overshoot = effectiveObjectSize - segmentLength + currentDistance; // how much past current point
                Vector3 position = Vector3.Lerp(currentPoint, previousPoint, overshoot / segmentLength);

                RaycastHit hit;
                if (RaycastToTerrain(position + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    position.y = hit.point.y;
                }
                else
                {
                    continue; // Skip if no terrain found
                }

                Vector3 direction = (currentPoint - previousPoint).normalized;
                Quaternion objectRotation = Quaternion.LookRotation(direction);

                if (rotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0);
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    position += perpendicularOffset;
                }

                if (IsValidPlacement(position, boundsExtents, canOverlap, occupyGrid))
                {
                    GameObject obj = Instantiate(objectPrefab, position, objectRotation, _currentPlacementParent.transform);
                    if (occupyGrid)
                    {
                        MarkGridCellsOccupied(position, boundsExtents);
                    }
                    placedObjects.Add(obj);
                }
            }
            previousPoint = currentPoint;
        }
    }


    // New: Utility to combine meshes for performance
    // Takes a list of GameObjects (each with a MeshFilter and MeshRenderer),
    // combines their meshes into a single new GameObject, and destroys originals.
    private GameObject CombineMeshes(List<GameObject> objectsToCombine, Material assignedMaterial, string combinedObjectName)
    {
        if (objectsToCombine == null || objectsToCombine.Count == 0)
        {
            Debug.LogWarning("CombineMeshes: No objects provided to combine.");
            return null;
        }

        GameObject combinedObject = new GameObject(combinedObjectName);
        combinedObject.transform.SetParent(_currentPlacementParent.transform); // Set parent to the main placement parent
        combinedObject.transform.localPosition = Vector3.zero;
        combinedObject.transform.localRotation = Quaternion.identity;
        combinedObject.transform.localScale = Vector3.one;

        MeshFilter meshFilter = combinedObject.AddComponent<MeshFilter>();
        MeshRenderer meshRenderer = combinedObject.AddComponent<MeshRenderer>();

        List<CombineInstance> combineInstances = new List<CombineInstance>();

        foreach (GameObject obj in objectsToCombine)
        {
            if (obj == null) continue;

            MeshFilter[] meshFilters = obj.GetComponentsInChildren<MeshFilter>();
            foreach (MeshFilter mf in meshFilters)
            {
                CombineInstance ci = new CombineInstance
                {
                    mesh = mf.sharedMesh,
                    transform = mf.transform.localToWorldMatrix // Use world matrix to combine objects correctly regardless of their original parent
                };
                combineInstances.Add(ci);
            }
            Destroy(obj); // Destroy the original individual object
        }

        if (combineInstances.Count == 0)
        {
            Debug.LogWarning("CombineMeshes: No valid meshes found in objects to combine. Destroying empty combined object.");
            Destroy(combinedObject);
            return null;
        }

        meshFilter.mesh = new Mesh();
        meshFilter.mesh.indexFormat = UnityEngine.Rendering.IndexFormat.UInt32; // For larger meshes
        meshFilter.mesh.CombineMeshes(combineInstances.ToArray(), true, true); // Merge submeshes, use world space

        if (assignedMaterial == null)
        {
            Debug.LogError("CombineMeshes: No material found for the combined mesh. It will be invisible. Please ensure your prefab has a MeshRenderer with a material assigned.");
        }
        meshRenderer.sharedMaterial = assignedMaterial; // Assign the material

        // Recalculate normals and bounds after combining
        meshFilter.mesh.RecalculateNormals();
        meshFilter.mesh.RecalculateBounds();
        meshFilter.mesh.Optimize(); // Optimize the combined mesh

        Debug.Log($"Combined {objectsToCombine.Count} meshes into a single object: {combinedObject.name}");

        return combinedObject;
    }
