    // New: Generates previews for objects filling a circle
    private void GenerateCircleFillPreviews(Vector3 center, float radius, GameObject ghostPrefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        if (ghostPrefab == null) return;

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;
        float effectiveFillSpacing = Mathf.Max(objectWidth, objectLength) + spacing; // Use larger dimension for spacing

        // Iterate in a square grid within the circle's bounding box
        for (float x = center.x - radius; x <= center.x + radius; x += effectiveFillSpacing)
        {
            for (float z = center.z - radius; z <= center.z + radius; z += effectiveFillSpacing)
            {
                Vector3 testPoint = new Vector3(x, center.y, z);
                // Check if the point is within the circle
                if (Vector3.Distance(center, testPoint) <= radius)
                {
                    Vector3 placementPosition = testPoint;
                    RaycastHit hit;
                    if (RaycastToTerrain(placementPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        placementPosition.y = hit.point.y;
                    }

                    bool isValid = IsValidPlacement(placementPosition, boundsExtents, canOverlap, occupyGrid);
                    GameObject preview = Instantiate(ghostPrefab, placementPosition, Quaternion.identity);
                    currentObjectPreviews.Add(preview);
                    SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
                }
            }
        }
    }

    // New: Generates previews for line loop fill
    private void GenerateLineLoopFillPreviews(List<Vector3> points, Vector3 currentMousePosition, GameObject ghostPrefab, Vector3 boundsExtents, float spacing, bool canOverlap, bool occupyGrid)
    {
        if (points.Count < 2 || ghostPrefab == null) return;

        // Create a temporary list of points including the current mouse position to form the preview polygon
        List<Vector3> previewPoints = new List<Vector3>(points);
        previewPoints.Add(currentMousePosition);

        // Ensure at least 3 points to form a polygon for fill
        if (previewPoints.Count < 3) return;

        // Determine bounding box of the polygon
        float minX = float.MaxValue, maxX = float.MinValue;
        float minZ = float.MaxValue, maxZ = float.MinValue;
        foreach (Vector3 p in previewPoints)
        {
            minX = Mathf.Min(minX, p.x);
            maxX = Mathf.Max(maxX, p.x);
            minZ = Mathf.Min(minZ, p.z);
            maxZ = Mathf.Max(maxZ, p.z);
        }

        float objectWidth = boundsExtents.x * 2;
        float objectLength = boundsExtents.z * 2;
        float effectiveFillSpacingX = objectWidth + spacing;
        float effectiveFillSpacingZ = objectLength + spacing;

        // Iterate through a grid within the bounding box
        for (float x = minX + objectWidth / 2f; x <= maxX - objectWidth / 2f + 0.01f; x += effectiveFillSpacingX)
        {
            for (float z = minZ + objectLength / 2f; z <= maxZ - objectLength / 2f + 0.01f; z += effectiveFillSpacingZ)
            {
                Vector3 testPoint = new Vector3(x, previewPoints[0].y, z); // Use first point's Y for raycasting height

                // Check if the point is inside the polygon (using a simple raycasting algorithm, assuming convex or non-complex polygons)
                // This is a simplified check. For complex polygons, a more robust point-in-polygon algorithm is needed.
                if (IsPointInPolygon(testPoint, previewPoints))
                {
                    Vector3 placementPosition = testPoint;
                    RaycastHit hit;
                    if (RaycastToTerrain(placementPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        placementPosition.y = hit.point.y;
                    }

                    bool isValid = IsValidPlacement(placementPosition, boundsExtents, canOverlap, occupyGrid);
                    GameObject preview = Instantiate(ghostPrefab, placementPosition, Quaternion.identity);
                    currentObjectPreviews.Add(preview);
                    SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
                }
            }
        }
    }

    // Simple Point-in-Polygon test (for 2D projection on XZ plane)
    // Assumes the polygon is defined by `polygonPoints` in order.
    private bool IsPointInPolygon(Vector3 testPoint, List<Vector3> polygonPoints)
    {
        int j = polygonPoints.Count - 1;
        bool inside = false;
        for (int i = 0; i < polygonPoints.Count; j = i++)
        {
            Vector3 pi = polygonPoints[i];
            Vector3 pj = polygonPoints[j];

            if (((pi.z <= testPoint.z && testPoint.z < pj.z) || (pj.z <= testPoint.z && testPoint.z < pi.z)) &&
                (testPoint.x < (pj.x - pi.x) * (testPoint.z - pi.z) / (pj.z - pi.z) + pi.x))
            {
                inside = !inside;
            }
        }
        return inside;
    }


