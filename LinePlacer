        Vector3 p2 = new Vector3(maxCorner.x, minCorner.y, minCorner.z);
        Vector3 p3 = new Vector3(maxCorner.x, minCorner.y, maxCorner.z);
        Vector3 p4 = new Vector3(minCorner.x, minCorner.y, maxCorner.z);

        List<Vector3> perimeterPoints = new List<Vector3> { p1, p2, p3, p4, p1 }; // Closing the loop

