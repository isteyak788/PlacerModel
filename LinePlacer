    // Method to place objects along the defined line segments
    private void PlaceAllObjectsFromLine()
    {
        if (linePoints.Count < 2 || _currentActiveLinePlacementPrefab == null)
        {
            Debug.LogWarning("Not enough points or no line prefab to place objects from line.");
            return;
        }

        List<GameObject> placedObjects = new List<GameObject>();
        Vector3 lineBoundsExtents = _currentSelectedEntry.lineBuildingInfo.buildingBoundsExtents;
        float objectLength = lineBoundsExtents.z * 2;
        float objectWidth = lineBoundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        // Generate interpolated points for placement
        List<Vector3> interpolatedPoints = new List<Vector3>();
        for (int i = 0; i < linePoints.Count - 1; i++)
        {
            Vector3 p0 = i == 0 ? linePoints[0] : linePoints[i - 1]; // Use first point twice if at start
            Vector3 p1 = linePoints[i];
            Vector3 p2 = linePoints[i + 1];
            Vector3 p3 = (i + 2 >= linePoints.Count) ? linePoints[linePoints.Count - 1] : linePoints[i + 2]; // Use last point twice if at end

            for (int j = 0; j <= curveResolution; j++)
            {
                float t = (float)j / curveResolution;
                Vector3 interpolatedPoint = GetCatmullRomPosition(t, p0, p1, p2, p3);

                RaycastHit hit;
                if (RaycastToTerrain(interpolatedPoint + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    interpolatedPoint.y = hit.point.y;
                }
                interpolatedPoints.Add(interpolatedPoint);
            }
        }

        PlaceObjectsAlongPath(interpolatedPoints, _currentActiveLinePlacementPrefab, lineBoundsExtents, objectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid, objectsRotatedRightOfLine, placedObjects);

        if (_currentSelectedEntry.combineLineMeshes && placedObjects.Count > 0)
        {
            CombineMeshes(placedObjects, "CombinedLineMesh", _currentPlacementParent);
        }
    }

