    // Catmull-Rom Spline Interpolation function
    private Vector3 CatmullRom(Vector3 p0, Vector3 p1, Vector3 p2, Vector3 p3, float t)
    {
        float t2 = t * t;
        float t3 = t2 * t;

        return 0.5f * (
            (2f * p1) +
            (-p0 + p2) * t +
            (2f * p0 - 5f * p1 + 4f * p2 - p3) * t2 +
            (-p0 + 3f * p1 - 3f * p2 + p3) * t3
        );
    }

    /// <summary>
    /// Generates a list of curved points from the original input points using Catmull-Rom.
    /// Supports both open and closed loops.
    /// </summary>
    /// <param name="inputPoints">The control points for the curve.</param>
    /// <param name="resolutionPerSegment">How many interpolated points to generate per segment.</param>
    /// <param name="closedLoop">If true, the curve will loop back to the first point smoothly.</param>
    /// <returns>A list of interpolated points forming the curve.</returns>
    private List<Vector3> GetCurvedPoints(List<Vector3> inputPoints, int resolutionPerSegment, bool closedLoop)
    {
        List<Vector3> curvedPoints = new List<Vector3>();

        if (inputPoints.Count < 2)
        {
            return new List<Vector3>(inputPoints);
        }

        List<Vector3> controlPoints = new List<Vector3>(inputPoints);

        if (closedLoop && inputPoints.Count >= 3)
        {
            // For a closed loop, add the last point before the first for the start of the spline,
            // and the first two points again at the end for the end of the spline.
            controlPoints.Insert(0, inputPoints[inputPoints.Count - 1]);
            controlPoints.Add(inputPoints[0]);
            controlPoints.Add(inputPoints[1]);
        }
        else
        {
            // For an open loop, duplicate the first and last points
            // to provide "tension" and make the curve start and end at the actual control points.
            controlPoints.Insert(0, inputPoints[0]);
            controlPoints.Add(inputPoints[inputPoints.Count - 1]);
        }

        // The number of segments is controlPoints.Count - 3 because each segment needs 4 control points.
        // For example, points 0,1,2,3 define the first segment between 1 and 2.
        for (int i = 0; i < controlPoints.Count - 3; i++)
        {
            Vector3 p0 = controlPoints[i];
            Vector3 p1 = controlPoints[i + 1];
            Vector3 p2 = controlPoints[i + 2];
            Vector3 p3 = controlPoints[i + 3];

            for (int j = 0; j <= resolutionPerSegment; j++)
            {
                float t = (float)j / resolutionPerSegment;
                Vector3 interpolatedPoint = CatmullRom(p0, p1, p2, p3, t);

                // Ensure no duplicate points are added (important for last point of a segment matching first of next)
                // or if it's the very first point being added.
                if (curvedPoints.Count == 0 || Vector3.Distance(curvedPoints.Last(), interpolatedPoint) > 0.0001f)
                {
                    curvedPoints.Add(interpolatedPoint);
                }
            }
        }
        
        return curvedPoints;
    }


    /// <summary>
    /// Updates the visual object previews along the drawn curved line.
    /// </summary>
    /// <param name="isFinalPlacement">True if this is for final placement, false for live preview.</param>
    /// <param name="closedLoop">True if the line should form a closed loop.</param>
    private void UpdateLineObjectPreviews(bool isFinalPlacement, bool closedLoop)
    {
        ClearObjectPreviews();

        if (_currentSelectedEntry == null || !_currentSelectedEntry.showGhost || _currentActiveGhostPrefab == null || linePoints.Count < 1) return;

        List<Vector3> pointsForCurveGeneration = new List<Vector3>(linePoints);

        // Add the current mouse position as a temporary last point for live preview if not finalizing
        if (!isFinalPlacement && _mouseWorldPositionFound && linePoints.Count > 0)
        {
            pointsForCurveGeneration.Add(_mouseWorldPosition);
        }

        // Only generate curve if there are enough points for the chosen mode (after adding temporary mouse point)
        // For Catmull-Rom, you need at least 4 control points for the first segment to curve properly,
        // so with padding, a minimum of 2 or 3 actual user points is usually required to see a curve.
        
        // These variables are declared outside this 'if' block to avoid CS0136 errors.
        Vector3 boundsExtents = _currentSelectedEntry.buildingInfo.buildingBoundsExtents;
        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        float currentPathDistance = 0f;
        float nextObjectDistanceTarget = effectiveObjectSize / 2f; // Start placing roughly halfway into the first object's length


        if (pointsForCurveGeneration.Count < (closedLoop ? 3 : 2)) // Still need at least 2 points to define a line (even a straight one)
        {
            // For straight lines or very few points (e.g., 1 or 2 user-defined points),
            // just show a ghost at the mouse position or between the two points.
            if (_currentSelectedEntry.showGhost && _currentActiveGhostPrefab != null && linePoints.Count >= 1 && _mouseWorldPositionFound && !isFinalPlacement)
            {
                // Show a ghost at the mouse position for the current segment
                Vector3 lastPoint = linePoints.Last();
                Vector3 currentMousePoint = _mouseWorldPosition;

                // Simple straight line placement for 1 point (at mouse) or 2 points (between them)
                if (linePoints.Count == 1)
                {
                    Vector3 previewPos = currentMousePoint;
                     RaycastHit hit;
                    if (RaycastToTerrain(previewPos + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                    {
                        previewPos = hit.point;
                    }

                    bool isValid = IsValidPlacement(previewPos, _currentSelectedEntry.buildingInfo.buildingBoundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
                    GameObject preview = Instantiate(_currentActiveGhostPrefab, previewPos, Quaternion.identity); // Default rotation
                    currentObjectPreviews.Add(preview);
                    SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
                }
                else if (linePoints.Count >= 2) // For 2 or more points, we can draw along the current segment
                {
                    // Generate a temporary 2-point straight line or simple curve if applicable
                    List<Vector3> tempCurvedPath;
                    if (pointsForCurveGeneration.Count >= (closedLoop ? 3 : 2))
                    {
                         tempCurvedPath = GetCurvedPoints(pointsForCurveGeneration, curveResolution, closedLoop);
                    }
                    else
                    {
                        tempCurvedPath = new List<Vector3> { linePoints.Last(), _mouseWorldPosition }; // Just straight line to mouse
                    }

                    if (tempCurvedPath.Count < 2) return; // Should not happen if pointsForCurveGeneration is sufficient

                    // Use the existing 'boundsExtents', 'objectLength', 'objectWidth', 'effectiveObjectSize', 'currentPathDistance', 'nextObjectDistanceTarget'
                    // from the outer scope. Do NOT redeclare them here.

                    for (int i = 0; i < tempCurvedPath.Count - 1; i++)
                    {
                        Vector3 currentPoint = tempCurvedPath[i];
                        Vector3 nextPoint = tempCurvedPath[i + 1];
                        float segmentLength = Vector3.Distance(currentPoint, nextPoint);

                        while (currentPathDistance + segmentLength >= nextObjectDistanceTarget)
                        {
                            float distanceIntoSegment = nextObjectDistanceTarget - currentPathDistance;
                            Vector3 previewPosition = Vector3.Lerp(currentPoint, nextPoint, distanceIntoSegment / segmentLength);

                            Vector3 direction = (nextPoint - currentPoint).normalized;
                            if (direction == Vector3.zero && i > 0)
                            {
                                direction = (currentPoint - tempCurvedPath[i - 1]).normalized;
                            }
                            if (direction == Vector3.zero) direction = Vector3.forward;

                            RaycastHit hit;
                            if (RaycastToTerrain(previewPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                            {
                                previewPosition = hit.point;
                            }
                            else
                            {
                                nextObjectDistanceTarget += effectiveObjectSize;
                                continue;
                            }

                            Quaternion objectRotation = Quaternion.LookRotation(direction);
                            if (objectsRotatedRightOfLine)
                            {
                                objectRotation *= Quaternion.Euler(0, 90, 0);
                                Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                                previewPosition += perpendicularOffset;
                            }

                            bool isValid = IsValidPlacement(previewPosition, boundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);

                            GameObject preview = Instantiate(_currentActiveGhostPrefab, previewPosition, objectRotation);
                            currentObjectPreviews.Add(preview);
                            SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);

                            nextObjectDistanceTarget += effectiveObjectSize;
                        }
                        currentPathDistance += segmentLength;
                    }
                }
            }
            return;
        }

        List<Vector3> curvedPath = GetCurvedPoints(pointsForCurveGeneration, curveResolution, closedLoop);
        
        if (curvedPath.Count < 2) return;

        // Use the existing 'boundsExtents', 'objectLength', 'objectWidth', 'effectiveObjectSize', 'currentPathDistance', 'nextObjectDistanceTarget'
        // from the outer scope. Do NOT redeclare them here.

        for (int i = 0; i < curvedPath.Count - 1; i++)
        {
            Vector3 currentPoint = curvedPath[i];
            Vector3 nextPoint = curvedPath[i + 1];
            float segmentLength = Vector3.Distance(currentPoint, nextPoint);

            while (currentPathDistance + segmentLength >= nextObjectDistanceTarget)
            {
                float distanceIntoSegment = nextObjectDistanceTarget - currentPathDistance;
                Vector3 previewPosition = Vector3.Lerp(currentPoint, nextPoint, distanceIntoSegment / segmentLength);

                Vector3 direction = (nextPoint - currentPoint).normalized;
                if (direction == Vector3.zero && i > 0)
                {
                    // Fallback to previous segment's direction if current segment is too short
                    direction = (currentPoint - curvedPath[i - 1]).normalized;
                }
                if (direction == Vector3.zero) direction = Vector3.forward; // Absolute fallback

                RaycastHit hit;
                if (RaycastToTerrain(previewPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    previewPosition = hit.point;
                }
                else
                {
                    nextObjectDistanceTarget += effectiveObjectSize;
                    continue; // Skip placing if it doesn't hit terrain
                }

                Quaternion objectRotation = Quaternion.LookRotation(direction);
                if (objectsRotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0);
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    previewPosition += perpendicularOffset;
                }

                bool isValid = IsValidPlacement(previewPosition, boundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);

                GameObject preview = Instantiate(_currentActiveGhostPrefab, previewPosition, objectRotation);
                currentObjectPreviews.Add(preview);
                SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);

                nextObjectDistanceTarget += effectiveObjectSize;
            }
            currentPathDistance += segmentLength;
        }

        // If LineLoopFill, also show a preview of the fill. This is a simplified approach,
        // a true polygon fill preview is more complex and might involve triangulation.
        if (_currentActiveMode == ActivePlacementMode.LineLoopFill && linePoints.Count >= 3)
        {
            // For a basic visual cue, we can try to place one ghost object at the center of the loop.
            // A more robust solution would involve triangulating the polygon and filling it with ghosts.
            Vector3 centroid = Vector3.zero;
            foreach(Vector3 p in linePoints)
            {
                centroid += p;
            }
            centroid /= linePoints.Count;

            RaycastHit hit;
            if (RaycastToTerrain(centroid + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
            {
                centroid = hit.point;
            }

            bool isValid = IsValidPlacement(centroid, boundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);
            GameObject preview = Instantiate(_currentActiveGhostPrefab, centroid, Quaternion.identity); // No specific rotation for fill centroid
            currentObjectPreviews.Add(preview);
            SetPreviewMaterial(preview, isValid ? validPlacementMaterial : invalidPlacementMaterial);
        }
    }


    private void PlaceAllObjectsFromLine()
    {
        ClearObjectPreviews(); // Clear any existing previews

        List<Vector3> curvedPath = GetCurvedPoints(linePoints, curveResolution, false); // Not a closed loop for 'Line' mode

        if (curvedPath.Count < 2)
        {
            Debug.LogWarning("Not enough points to place objects along the line.");
            ExitPlacementMode();
            return;
        }

        Vector3 boundsExtents = _currentSelectedEntry.buildingInfo.buildingBoundsExtents;
        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        float currentPathDistance = 0f;
        float nextObjectDistanceTarget = effectiveObjectSize / 2f;

        for (int i = 0; i < curvedPath.Count - 1; i++)
        {
            Vector3 currentPoint = curvedPath[i];
            Vector3 nextPoint = curvedPath[i + 1];
            float segmentLength = Vector3.Distance(currentPoint, nextPoint);

            while (currentPathDistance + segmentLength >= nextObjectDistanceTarget)
            {
                float distanceIntoSegment = nextObjectDistanceTarget - currentPathDistance;
                Vector3 placementPosition = Vector3.Lerp(currentPoint, nextPoint, distanceIntoSegment / segmentLength);

                Vector3 direction = (nextPoint - currentPoint).normalized;
                if (direction == Vector3.zero && i > 0)
                {
                    direction = (currentPoint - curvedPath[i - 1]).normalized;
                }
                if (direction == Vector3.zero) direction = Vector3.forward;

                RaycastHit hit;
                if (RaycastToTerrain(placementPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    placementPosition = hit.point;
                }
                else
                {
                    nextObjectDistanceTarget += effectiveObjectSize;
                    continue;
                }

                Quaternion objectRotation = Quaternion.LookRotation(direction);
                if (objectsRotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0);
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    placementPosition += perpendicularOffset;
                }

                if (IsValidPlacement(placementPosition, boundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid))
                {
                    Instantiate(_currentActivePlacementPrefab, placementPosition, objectRotation);
                    // Mark occupied grid cells if applicable
                    if (_currentSelectedEntry.occupyGrid)
                    {
                        MarkOccupiedCells(placementPosition, boundsExtents);
                    }
                }
                nextObjectDistanceTarget += effectiveObjectSize;
            }
            currentPathDistance += segmentLength;
        }

        if (!_currentSelectedEntry.isContinuous)
        {
            ExitPlacementMode();
        }
        else
        {
            // For continuous mode, clear points for next line
            linePoints.Clear();
            currentState = LinePlacementState.Idle; // Go back to idle to await next first click
        }
    }

    private void PlaceAllObjectsFromLineLoop()
    {
        ClearObjectPreviews();

        if (linePoints.Count < 3)
        {
            Debug.LogWarning("Need at least 3 points to form a line loop.");
            ExitPlacementMode();
            return;
        }

        List<Vector3> curvedPath = GetCurvedPoints(linePoints, curveResolution, true); // True for closed loop

        if (curvedPath.Count < 2) // Should be at least 2 for a closed loop to have segments
        {
            Debug.LogWarning("Failed to generate curved path for line loop.");
            ExitPlacementMode();
            return;
        }

        Vector3 boundsExtents = _currentSelectedEntry.buildingInfo.buildingBoundsExtents;
        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        float currentPathDistance = 0f;
        float nextObjectDistanceTarget = effectiveObjectSize / 2f;

        // Iterate through segments of the curved path
        for (int i = 0; i < curvedPath.Count; i++)
        {
            Vector3 currentPoint = curvedPath[i];
            Vector3 nextPoint = curvedPath[(i + 1) % curvedPath.Count]; // Loop back to start

            float segmentLength = Vector3.Distance(currentPoint, nextPoint);

            while (currentPathDistance + segmentLength >= nextObjectDistanceTarget)
            {
                float distanceIntoSegment = nextObjectDistanceTarget - currentPathDistance;
                Vector3 placementPosition = Vector3.Lerp(currentPoint, nextPoint, distanceIntoSegment / segmentLength);

                Vector3 direction = (nextPoint - currentPoint).normalized;
                if (direction == Vector3.zero) direction = (curvedPath[i] - curvedPath[(i - 1 + curvedPath.Count) % curvedPath.Count]).normalized; // Fallback to previous point if segment too short
                if (direction == Vector3.zero) direction = Vector3.forward;

                RaycastHit hit;
                if (RaycastToTerrain(placementPosition + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
                {
                    placementPosition = hit.point;
                }
                else
                {
                    nextObjectDistanceTarget += effectiveObjectSize;
                    continue;
                }

                Quaternion objectRotation = Quaternion.LookRotation(direction);
                if (objectsRotatedRightOfLine)
                {
                    objectRotation *= Quaternion.Euler(0, 90, 0);
                    Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                    placementPosition += perpendicularOffset;
                }

                if (IsValidPlacement(placementPosition, boundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid))
                {
                    Instantiate(_currentActivePlacementPrefab, placementPosition, objectRotation);
                    if (_currentSelectedEntry.occupyGrid)
                    {
                        MarkOccupiedCells(placementPosition, boundsExtents);
                    }
                }
                nextObjectDistanceTarget += effectiveObjectSize;
            }
            currentPathDistance += segmentLength;
        }

        if (!_currentSelectedEntry.isContinuous)
        {
            ExitPlacementMode();
        }
        else
        {
            linePoints.Clear();
            currentState = LinePlacementState.Idle;
        }
    }


    private void PlaceAllObjectsFromLineLoopFill()
    {
        ClearObjectPreviews();

        if (linePoints.Count < 3)
        {
            Debug.LogWarning("Need at least 3 points to form a line loop fill.");
            ExitPlacementMode();
            return;
        }

        // First, place objects along the perimeter (same as LineLoop)
        PlaceAllObjectsFromLineLoop(); // This will handle the perimeter placement and exit if not continuous

        // Then, fill the interior with objects
        // Pass relevant parameters from the current selected entry's building info
        FillPolygonWithObjects(linePoints, _currentActivePlacementPrefab, _currentSelectedEntry.buildingInfo.buildingBoundsExtents, fillObjectSpacing, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid);

        if (!_currentSelectedEntry.isContinuous)
        {
            ExitPlacementMode(); // Exit only if not continuous, PlaceAllObjectsFromLineLoop might have already handled it
        }
        else
        {
            // If continuous, we want to clear points and go back to idle to start new drawing
            linePoints.Clear();
            currentState = LinePlacementState.Idle;
        }
    }

    private void PlaceObjectsInCircle()
    {
        ClearObjectPreviews();

        if (_circleRadius <= minBoxSize)
        {
            Debug.LogWarning($"Circle radius too small to place objects. Minimum radius: {minBoxSize}.");
            ExitPlacementMode();
            return;
        }

        Vector3 boundsExtents = _currentSelectedEntry.buildingInfo.buildingBoundsExtents;
        float objectLength = boundsExtents.z * 2;
        float objectWidth = boundsExtents.x * 2;
        float effectiveObjectSize = objectLength + objectSpacing;

        float circumference = 2 * Mathf.PI * _circleRadius;
        int numberOfObjects = Mathf.FloorToInt(circumference / effectiveObjectSize);
        if (numberOfObjects == 0)
        {
            Debug.LogWarning("No objects can fit on the circle circumference with current spacing.");
            ExitPlacementMode();
            return;
        }

        float angleStep = 360f / numberOfObjects;

        for (int i = 0; i < numberOfObjects; i++)
        {
            float angle = i * angleStep;
            Vector3 pointOnCircle = _circleCenter + new Vector3(Mathf.Cos(Mathf.Deg2Rad * angle), 0, Mathf.Sin(Mathf.Deg2Rad * angle)) * _circleRadius;

            RaycastHit hit;
            if (RaycastToTerrain(pointOnCircle + Vector3.up * terrainRaycastStartHeight, out hit, placementLayerMask))
            {
                pointOnCircle.y = hit.point.y;
            }
            else
            {
                Debug.LogWarning($"Circle placement point at X:{pointOnCircle.x}, Z:{pointOnCircle.z} did not hit ground. Skipping this object.");
                continue;
            }

            Vector3 direction = (pointOnCircle - _circleCenter).normalized;
            Quaternion objectRotation = Quaternion.LookRotation(direction);

            if (objectsRotatedRightOfLine)
            {
                objectRotation *= Quaternion.Euler(0, 90, 0);
                Vector3 perpendicularOffset = objectRotation * Vector3.forward * (objectWidth / 2f);
                pointOnCircle += perpendicularOffset;
            }

            if (IsValidPlacement(pointOnCircle, boundsExtents, _currentSelectedEntry.canOverlap, _currentSelectedEntry.occupyGrid))
            {
                Instantiate(_currentActivePlacementPrefab, pointOnCircle, objectRotation);
                if (_currentSelectedEntry.occupyGrid)
                {
                    MarkOccupiedCells(pointOnCircle, boundsExtents);
                }
            }
        }

        if (!_currentSelectedEntry.isContinuous)
        {
            ExitPlacementMode();
        }
        else
        {
            _isDrawingCircle = false;
            _circleRadius = 0;
            currentState = LinePlacementState.Idle;
        }
    }


