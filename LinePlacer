    private void FinalizePlacement()
    {
        ClearObjectPreviews(); // Clear any remaining previews

        if (!_currentSelectedEntry.isContinuous)
        {
            ExitPlacementMode(forceDestroyParent: false); // Don't force destroy, let parent logic handle it
        }
        else
        {
            // For continuous mode, reset state to idle for next click, but keep parent active.
            // Don't clear linePoints as user might want to extend the line.
            currentState = LinePlacementState.Idle;
            // Clear box/circle specific states
            _isDraggingBox = false;
            _isDrawingCircle = false;
            _circleRadius = 0;

            linePoints.Clear(); // Clear line points after finalizing a segment in continuous mode

            // Re-enable buttons if continuous is off, but for continuous, stay in mode and re-setup UI
            SetAllPlacementButtonsInteractable(false); // Keep disabled as we are still in a continuous mode
            Debug.Log($"Continuous {_currentActiveMode} placement active. Click to place another. Press Right Click to cancel this mode.");
        }
    }


    // --- Helper Methods (Potentially from other files or not provided) ---
    private bool RaycastToTerrain(Vector3 origin, out RaycastHit hit, LayerMask layerMask)
    {
        return Physics.Raycast(origin, Vector3.down, out hit, Mathf.Infinity, layerMask);
    }

    private bool IsValidPlacement(Vector3 position, Vector3 boundsExtents, bool canOverlap, bool occupyGrid)
    {
        if (occupyGrid)
        {
            Vector2Int minGridCell = WorldToGrid(position - boundsExtents);
            Vector2Int maxGridCell = WorldToGrid(position + boundsExtents);

            for (int x = minGridCell.x; x <= maxGridCell.x; x++)
            {
                for (int z = minGridCell.y; z <= maxGridCell.y; z++)
                {
                    if (_occupiedGridCells.Contains(new Vector2Int(x, z)))
                    {
                        if (!canOverlap) return false; // Collision detected, and overlaps not allowed
                    }
                }
            }
        }

        // Basic overlap check with colliders in the scene, if needed (beyond grid)
        if (!canOverlap)
        {
            Collider[] hits = Physics.OverlapBox(position, boundsExtents, Quaternion.identity, overlapCheckLayerMask);
            if (hits.Length > 0)
            {
                // Filter out current previews if they happen to have colliders
                // (shouldn't be an issue if previews don't have colliders or are on ignore layer)
                bool actualOverlap = false;
                foreach (Collider c in hits)
                {
                    // Check if the hit collider is NOT part of a preview object
                    if (!currentObjectPreviews.Any(p => p == c.gameObject || c.transform.IsChildOf(p.transform)))
                    {
                        actualOverlap = true;
                        break;
                    }
                }
                if (actualOverlap) return false;
            }
        }

        return true;
    }

    private void OccupyGridCells(Vector3 position, Vector3 boundsExtents)
    {
        if (!_currentSelectedEntry.occupyGrid) return;

        Vector2Int minGridCell = WorldToGrid(position - boundsExtents);
        Vector2Int maxGridCell = WorldToGrid(position + boundsExtents);

        for (int x = minGridCell.x; x <= maxGridCell.x; x++)
        {
            for (int z = minGridCell.y; z <= maxGridCell.y; z++)
            {
                _occupiedGridCells.Add(new Vector2Int(x, z));
            }
        }
    }

    private Vector2Int WorldToGrid(Vector3 worldPos)
    {
        return new Vector2Int(
            Mathf.FloorToInt(worldPos.x / gridSize),
            Mathf.FloorToInt(worldPos.z / gridSize)
        );
    }

    // Point in Polygon check (Ray Casting algorithm / Winding Number for complex polygons)
    // This is a simple ray-casting algorithm for a 2D polygon (ignoring Y for height)
    private bool PointInPolygon(Vector3 point, List<Vector3> polygon)
    {
        int j = polygon.Count - 1;
        bool inside = false;
        for (int i = 0; i < polygon.Count; i++)
        {
            // Check if the horizontal ray from the point intersects the polygon edge
            if (((polygon[i].z <= point.z && point.z < polygon[j].z) || (polygon[j].z <= point.z && point.z < polygon[i].z)) &&
                (point.x < (polygon[j].x - polygon[i].x) * (point.z - polygon[i].z) / (polygon[j].z - polygon[i].z) + polygon[i].x))
            {
                inside = !inside;
            }
            j = i;
        }
        return inside;
    }

